#!/usr/bin/env node

// src/cli/args.ts
class UsageError extends Error {
}
var GLOBAL_FLAGS = {
  values: ["--repo"],
  switches: ["--json", "--help"]
};
function mergeFlags(...specs) {
  return {
    values: specs.flatMap((spec) => [...spec.values]),
    switches: specs.flatMap((spec) => [...spec.switches])
  };
}
function parseArgs(argv, spec) {
  const values = new Map;
  const switches = new Set;
  const positional = [];
  let literal = false;
  for (let i = 0;i < argv.length; i++) {
    const word = argv[i] ?? "";
    if (literal || !word.startsWith("--")) {
      positional.push(word);
      continue;
    }
    if (word === "--") {
      literal = true;
      continue;
    }
    const eq = word.indexOf("=");
    const name = eq === -1 ? word : word.slice(0, eq);
    if (spec.switches.includes(name)) {
      if (eq !== -1)
        throw new UsageError(`${name} takes no value`);
      switches.add(name);
      continue;
    }
    if (!spec.values.includes(name)) {
      throw new UsageError(`unknown flag ${name}`);
    }
    let value;
    if (eq !== -1) {
      value = word.slice(eq + 1);
    } else {
      const next = argv[i + 1];
      if (next === undefined || next.startsWith("--")) {
        throw new UsageError(`${name} needs a value`);
      }
      value = next;
      i++;
    }
    values.set(name, [...values.get(name) ?? [], value]);
  }
  return { positional, values, switches };
}
function single(parsed, name) {
  const found = parsed.values.get(name);
  if (found === undefined)
    return;
  if (found.length > 1)
    throw new UsageError(`${name} given more than once`);
  return found[0];
}

// src/protocol/closing-keywords.ts
var CLOSING_KEYWORD = /(?<![A-Za-z0-9])(close[sd]?|fix(?:e[sd])?|resolve[sd]?)(?![A-Za-z0-9])[\s:*_]*(https?:\/\/(?:(?:www\.)?github\.com|[\w-]+(?:\.[\w-]+)*\.ghe\.com)\/[\w.-]+\/[\w.-]+\/issues\/\d+|(?:[\w.-]+\/[\w.-]+)?(?:#|GH-)\d+)\b/gi;
function findClosingKeywords(text) {
  return [...text.matchAll(CLOSING_KEYWORD)].map((m) => ({
    line: text.slice(0, m.index).split(`
`).length,
    keyword: m[1] ?? "",
    reference: m[2] ?? ""
  }));
}
// src/protocol/events.ts
var ITEM_KINDS = ["message", "finding", "digest"];
var ACK_OUTCOMES = ["context", "band", "wake", "ignored"];
var SESSION_ROLES = ["lead", "worker"];
function encodeEvent(event) {
  return JSON.stringify(event);
}
var isString = (value) => typeof value === "string";
var isBoolean = (value) => typeof value === "boolean";
var isInt = (value) => Number.isInteger(value);
var oneOf = (options) => (value) => options.some((option) => option === value);
var SHAPES = {
  ready: {},
  item: {
    id: isString,
    kind: oneOf(ITEM_KINDS),
    text: isString,
    addressed: isBoolean
  },
  status: { text: isString },
  error: { message: isString },
  hello: {
    session: isString,
    role: oneOf(SESSION_ROLES),
    harness: isString,
    worktree: isString,
    pid: isInt
  },
  ack: { id: isString, outcome: oneOf(ACK_OUTCOMES) },
  bye: {}
};
var malformed = (detail) => ({
  ok: false,
  reason: "malformed",
  detail
});
function decodeEvent(line) {
  let raw;
  try {
    raw = JSON.parse(line);
  } catch {
    return malformed("not JSON");
  }
  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
    return malformed("not an object");
  }
  const fields = raw;
  const type = fields.type;
  if (!isString(type) || !Object.hasOwn(SHAPES, type))
    return malformed("unknown type");
  const shape = SHAPES[type];
  for (const [name, check] of Object.entries(shape)) {
    if (!check(fields[name]))
      return malformed(`bad ${name}`);
  }
  if (type === "item") {
    for (const name of ["from", "repo", "event", "msgId"]) {
      if (fields[name] !== undefined && !isString(fields[name]))
        return malformed(`bad ${name}`);
    }
    if (fields.thread !== undefined && !isInt(fields.thread))
      return malformed("bad thread");
    for (const name of ["wakeable", "ownPr"]) {
      if (fields[name] !== undefined && !isBoolean(fields[name]))
        return malformed(`bad ${name}`);
    }
  }
  if (type === "hello") {
    for (const name of ["repo", "branch"]) {
      if (fields[name] !== undefined && !isString(fields[name]))
        return malformed(`bad ${name}`);
    }
    const settings = fields.settings;
    if (typeof settings !== "object" || settings === null || !isBoolean(settings.autoWake)) {
      return malformed("bad settings");
    }
  }
  return { ok: true, event: fields };
}
// src/protocol/message.ts
var MESSAGE_KINDS = [
  "ask",
  "review",
  "fix",
  "bug",
  "info",
  "reply"
];
var REQUEST_KINDS = ["ask", "review", "fix", "bug"];
var REPLY_STATUSES = [
  "answered",
  "accepted",
  "declined",
  "done"
];
var LOGIN_PATTERN = "[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})";
var LOGIN = new RegExp(`^${LOGIN_PATTERN}$`);
var ID = /^[a-z0-9]{4,12}$/;
var MARKER = /^\s*<!--[ \t]*crew-net:msg(?=\s|-->)([\s\S]*?)-->/;
var isKind = (value) => MESSAGE_KINDS.some((kind) => kind === value);
var isStatus = (value) => REPLY_STATUSES.some((status) => status === value);
var isRequestKind = (kind) => REQUEST_KINDS.some((request) => request === kind);
var malformed2 = (detail) => ({
  ok: false,
  reason: "malformed",
  detail
});
function parseMessageMarker(body) {
  const match = MARKER.exec(body);
  if (!match)
    return null;
  const pairs = new Map;
  for (const token of (match[1] ?? "").split(/\s+/)) {
    const eq = token.indexOf("=");
    if (eq <= 0)
      continue;
    const key = token.slice(0, eq);
    if (!pairs.has(key))
      pairs.set(key, token.slice(eq + 1));
  }
  const kind = pairs.get("kind");
  if (!isKind(kind))
    return malformed2(`unknown kind ${kind ?? "(missing)"}`);
  const id = pairs.get("id");
  const re = pairs.get("re");
  const status = pairs.get("status");
  if (id !== undefined && !ID.test(id))
    return malformed2(`bad id ${id}`);
  if (re !== undefined && !ID.test(re))
    return malformed2(`bad re ${re}`);
  if (status !== undefined && !isStatus(status))
    return malformed2(`unknown status ${status}`);
  if (isRequestKind(kind) && id === undefined)
    return malformed2(`${kind} needs an id`);
  if (kind === "reply" && re === undefined)
    return malformed2("reply needs re");
  return {
    ok: true,
    marker: {
      kind,
      ...id === undefined ? {} : { id },
      ...re === undefined ? {} : { re },
      ...kind === "reply" && status !== undefined ? { status } : {}
    }
  };
}
var refuse = (field, detail) => ({
  ok: false,
  field,
  detail
});
function renderMessageMarker(marker) {
  if (!isKind(marker.kind))
    return refuse("kind", "unknown kind");
  if (marker.id !== undefined && !ID.test(marker.id))
    return refuse("id", "expected [a-z0-9]{4,12}");
  if (marker.re !== undefined && !ID.test(marker.re))
    return refuse("re", "expected [a-z0-9]{4,12}");
  if (marker.status !== undefined && !isStatus(marker.status))
    return refuse("status", "unknown status");
  if (marker.status !== undefined && marker.kind !== "reply")
    return refuse("status", "only replies carry a status");
  if (isRequestKind(marker.kind) && marker.id === undefined)
    return refuse("id", `${marker.kind} needs an id`);
  if (marker.kind === "reply" && marker.re === undefined)
    return refuse("re", "reply needs re");
  const parts = [`kind=${marker.kind}`];
  if (marker.id !== undefined)
    parts.push(`id=${marker.id}`);
  if (marker.re !== undefined)
    parts.push(`re=${marker.re}`);
  if (marker.status !== undefined)
    parts.push(`status=${marker.status}`);
  return { ok: true, marker: `<!-- crew-net:msg ${parts.join(" ")} -->` };
}
function mentionLine(login, text) {
  const first = text.trim();
  if (!LOGIN.test(login) || first === "")
    return null;
  return `@${login} ${first}`;
}
// src/protocol/remote.ts
function parseRepoIdentity(remote) {
  let host;
  let path;
  const scp = remote.match(/^[^/@\s]+@([^/:\s]+):(.*)$/);
  if (scp) {
    host = scp[1] ?? "";
    path = scp[2] ?? "";
  } else {
    const url = remote.match(/^(?:https?|ssh):\/\/(?:[^/@\s]*@)?([^/:@\s]+)(?::\d*)?\/([^?#\s]*)(?:[?#]\S*)?$/i);
    if (!url)
      throw new Error("Unsupported origin remote URL");
    host = url[1] ?? "";
    path = url[2] ?? "";
  }
  host = host.toLowerCase();
  if (host === "ssh.github.com")
    host = "github.com";
  if (!/^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$/.test(host))
    throw new Error("Origin remote has no valid host");
  path = path.replace(/\/$/, "").replace(/\.git$/, "");
  if (!/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(path))
    throw new Error("Origin remote must identify owner/repo");
  const [owner, repo] = path.split("/");
  if (owner === "." || owner === ".." || repo === "." || repo === "..")
    throw new Error("Invalid origin repository");
  return { host, repo: path };
}
// src/protocol/repo-config.ts
var DEFAULT_PRODUCER_PATTERNS = [
  "**/migrations/**",
  "**/*migration*",
  "api/openapi/**",
  "**/*.proto"
];
var DEFAULT_CONTRACT = {
  name: "schema",
  producer: DEFAULT_PRODUCER_PATTERNS,
  consumers: [{ pattern: "**" }]
};
var DEFAULT_REPO_CONFIG = {
  contracts: [DEFAULT_CONTRACT],
  deployBranches: ["main", "master"],
  bots: [],
  earlyDrafts: false,
  agentsMerge: false
};

class ConfigError extends Error {
  line;
  constructor(line, detail) {
    super(detail);
    this.line = line;
  }
}
var isSpace = (char) => char === undefined || char === " " || char === "\t";
var opensQuote = (text, i) => {
  const char = text[i];
  if (char !== '"' && char !== "'")
    return false;
  const prev = text[i - 1];
  return isSpace(prev) || prev === "[" || prev === ",";
};
function indexOutsideQuotes(text, separator) {
  let quote = null;
  for (let i = 0;i < text.length; i++) {
    const char = text[i];
    if (quote) {
      if (char === "\\" && quote === '"')
        i++;
      else if (char === quote)
        quote = null;
    } else if (opensQuote(text, i))
      quote = char ?? null;
    else if (separator(i))
      return i;
  }
  return -1;
}
function stripComment(text) {
  const at = indexOutsideQuotes(text, (i) => text[i] === "#" && isSpace(text[i - 1]));
  return (at < 0 ? text : text.slice(0, at)).trimEnd();
}
function tokenize(source) {
  const lines = [];
  source.split(/\r?\n/).forEach((raw, index) => {
    const no = index + 1;
    if (raw.trimEnd() === "---" && lines.length === 0)
      return;
    const text = stripComment(raw);
    if (text.trim() === "")
      return;
    const indent = text.length - text.trimStart().length;
    if (text.slice(0, indent).includes("\t"))
      throw new ConfigError(no, "tabs are not allowed for indentation");
    lines.push({ no, indent, text: text.slice(indent) });
  });
  return lines;
}
function unquote(token, no) {
  const quote = token[0];
  if (token.length < 2 || token[token.length - 1] !== quote)
    throw new ConfigError(no, `bad quoted string ${token}`);
  const inner = token.slice(1, -1);
  if (quote === "'") {
    if (/'(?!')/.test(inner.replace(/''/g, "")))
      throw new ConfigError(no, `text after closing quote in ${token}`);
    return inner.replace(/''/g, "'");
  }
  if (/(?<!\\)(?:\\\\)*"/.test(inner))
    throw new ConfigError(no, `text after closing quote in ${token}`);
  return inner.replace(/\\(["\\])/g, "$1");
}
function scalar(token, no) {
  if (token === "" || token === "~" || token === "null")
    return null;
  if (token === "-" || token.startsWith("- "))
    throw new ConfigError(no, `nested list item is not supported: ${token}`);
  if (token === "true")
    return true;
  if (token === "false")
    return false;
  if (token[0] === '"' || token[0] === "'")
    return unquote(token, no);
  if (/^[&*!|>{@`%]/.test(token))
    throw new ConfigError(no, `unsupported YAML syntax: ${token}`);
  if (token.includes(": "))
    throw new ConfigError(no, `unexpected ': ' in value ${token}`);
  return token;
}
function flowSequence(token, no) {
  if (!token.endsWith("]"))
    throw new ConfigError(no, "a [..] list must close on the same line");
  const inner = token.slice(1, -1);
  const items = [];
  let rest = inner;
  while (rest.trim() !== "") {
    const comma = indexOutsideQuotes(rest, (i) => rest[i] === ",");
    const part = (comma < 0 ? rest : rest.slice(0, comma)).trim();
    if (part === "")
      throw new ConfigError(no, "empty item in list");
    if (part[0] === "[" || part[0] === "{")
      throw new ConfigError(no, "nested lists and maps are not supported");
    items.push(scalar(part, no));
    if (comma < 0)
      break;
    rest = rest.slice(comma + 1);
    if (rest.trim() === "")
      throw new ConfigError(no, "trailing comma in list");
  }
  return items;
}
function inline(token, no) {
  if (token[0] === "[")
    return flowSequence(token, no);
  return scalar(token, no);
}
var KEY_LINE = /^([A-Za-z0-9_.-]+):(?:[ ]+(.*))?$/;
var isItem = (line) => line.text === "-" || line.text.startsWith("- ");
function parseDocument(lines) {
  let at = 0;
  const block = (indent) => {
    const line = lines[at];
    if (!line)
      return null;
    return isItem(line) ? sequence(indent) : mapping(indent);
  };
  const sequence = (indent) => {
    const items = [];
    for (let line = lines[at];line; line = lines[at]) {
      if (line.indent !== indent || !isItem(line))
        break;
      const rest = line.text.slice(1).trimStart();
      if (rest === "") {
        at++;
        const next = lines[at];
        items.push(next && next.indent > indent ? block(next.indent) : null);
      } else if (KEY_LINE.test(rest) && rest[0] !== '"' && rest[0] !== "'") {
        const offset = line.text.length - rest.length;
        lines[at] = { no: line.no, indent: indent + offset, text: rest };
        items.push(mapping(indent + offset));
      } else {
        at++;
        items.push(inline(rest, line.no));
      }
    }
    return items;
  };
  const mapping = (indent) => {
    const map = new Map;
    for (let line = lines[at];line; line = lines[at]) {
      if (line.indent < indent)
        break;
      if (line.indent > indent)
        throw new ConfigError(line.no, "unexpected indentation");
      if (isItem(line))
        throw new ConfigError(line.no, "unexpected list item");
      const match = KEY_LINE.exec(line.text);
      const key = match?.[1];
      if (key === undefined)
        throw new ConfigError(line.no, `expected "key: value", got ${line.text}`);
      if (map.has(key))
        throw new ConfigError(line.no, `duplicate key ${key}`);
      const value = (match?.[2] ?? "").trim();
      at++;
      if (value !== "") {
        map.set(key, inline(value, line.no));
        continue;
      }
      const next = lines[at];
      if (next && next.indent > indent)
        map.set(key, block(next.indent));
      else if (next && next.indent === indent && isItem(next))
        map.set(key, sequence(indent));
      else
        map.set(key, null);
    }
    return map;
  };
  const first = lines[0];
  if (!first)
    return new Map;
  if (first.indent !== 0 || isItem(first))
    throw new ConfigError(first.no, "expected top-level keys");
  const root = mapping(0);
  const stray = lines[at];
  if (stray)
    throw new ConfigError(stray.no, "unexpected indentation");
  return root;
}
var typeName = (node) => node === null ? "empty" : Array.isArray(node) ? "list" : node instanceof Map ? "map" : typeof node;
function strings(node, what) {
  if (node === undefined || node === null)
    return [];
  const items = Array.isArray(node) ? node : [node];
  return items.map((item) => {
    if (typeof item !== "string" || item === "")
      throw new ConfigError(null, `${what} must be a list of strings`);
    return item;
  });
}
function boolean(node, what, fallback) {
  if (node === undefined || node === null)
    return fallback;
  if (typeof node !== "boolean")
    throw new ConfigError(null, `${what} must be true or false`);
  return node;
}
var CONSUMER = /^([\w.-]+\/[\w.-]+):(.+)$/;
function consumer(text) {
  const match = CONSUMER.exec(text);
  const repo = match?.[1];
  const pattern = match?.[2];
  return repo !== undefined && pattern !== undefined ? { repo, pattern } : { pattern: text };
}
function contract(node, index) {
  const where = `contracts[${index}]`;
  if (!(node instanceof Map))
    throw new ConfigError(null, `${where} must be a mapping, got ${typeName(node)}`);
  const name = node.get("name");
  if (typeof name !== "string" || name === "")
    throw new ConfigError(null, `${where} needs a name`);
  const producer = strings(node.get("producer"), `${where}.producer`);
  const consumers = strings(node.get("consumers"), `${where}.consumers`);
  if (producer.length === 0)
    throw new ConfigError(null, `${where} (${name}) needs a producer`);
  if (consumers.length === 0)
    throw new ConfigError(null, `${where} (${name}) needs consumers`);
  return { name, producer, consumers: consumers.map(consumer) };
}
function toConfig(root) {
  if (!(root instanceof Map))
    throw new ConfigError(null, "expected a mapping");
  const contracts = root.get("contracts");
  if (contracts !== undefined && contracts !== null && !Array.isArray(contracts))
    throw new ConfigError(null, "contracts must be a list");
  const deploy = root.get("deploy-branches");
  return {
    contracts: contracts === undefined ? DEFAULT_REPO_CONFIG.contracts : (contracts ?? []).map(contract),
    deployBranches: deploy === undefined ? DEFAULT_REPO_CONFIG.deployBranches : strings(deploy, "deploy-branches"),
    bots: strings(root.get("bots"), "bots"),
    earlyDrafts: boolean(root.get("early-drafts"), "early-drafts", DEFAULT_REPO_CONFIG.earlyDrafts),
    agentsMerge: boolean(root.get("agents-merge"), "agents-merge", DEFAULT_REPO_CONFIG.agentsMerge)
  };
}
function parseRepoConfig(text) {
  try {
    return { ok: true, config: toConfig(parseDocument(tokenize(text))) };
  } catch (error) {
    if (error instanceof ConfigError)
      return { ok: false, line: error.line, detail: error.message };
    throw error;
  }
}
// src/protocol/state-block.ts
var PR_STATES = ["planning", "building", "review", "blocked"];
var KNOWN_FIELDS = new Set(["state", "scope", "depends-on", "lead"]);
var OPEN = /<!--\s*crew-net(?=\s|-->)/i;
var CLOSE = "-->";
var REF = /^(?:[\w.-]+\/[\w.-]+)?#\d+$/;
var KEY = /^[a-z][a-z0-9-]*$/;
var DEPENDS_ON_MENTION = /depends[-_ ]?on[ \t]*:/gi;
var LEGACY_TAG = /^v\d+(?:\.\d+)*(?=\s|$)/;
function readFields(inner) {
  const fields = new Map;
  for (const line of inner.split(`
`)) {
    const colon = line.indexOf(":");
    if (colon < 0)
      continue;
    const key = line.slice(0, colon).trim().toLowerCase();
    if (key && !fields.has(key))
      fields.set(key, line.slice(colon + 1).trim());
  }
  return fields;
}
function readExtras(fields) {
  return [...fields].filter(([key]) => KEY.test(key) && !KNOWN_FIELDS.has(key)).map(([key, value]) => ({ key, value }));
}
var list = (value) => (value ?? "").split(",").map((item) => item.trim()).filter(Boolean);
var dependsOnLines = (inner) => inner.split(`
`).filter((line) => {
  const colon = line.indexOf(":");
  return colon >= 0 && line.slice(0, colon).trim().toLowerCase() === "depends-on";
}).length;
function readBlock(inner) {
  const text = inner.trimStart().replace(LEGACY_TAG, "");
  const fields = readFields(text);
  const warnings = [];
  const lines = dependsOnLines(text);
  if ((text.match(DEPENDS_ON_MENTION)?.length ?? 0) !== lines || lines > 1) {
    warnings.push({
      field: "depends-on",
      value: "",
      detail: "must be one `depends-on:` line of its own"
    });
  }
  const rawState = fields.get("state");
  const state = PR_STATES.find((s) => s === rawState);
  if (rawState !== undefined && state === undefined) {
    warnings.push({
      field: "state",
      value: rawState,
      detail: "unknown state"
    });
  }
  const dependsOn = [];
  for (const ref of list(fields.get("depends-on"))) {
    if (REF.test(ref))
      dependsOn.push(ref);
    else
      warnings.push({ field: "depends-on", value: ref, detail: "bad ref" });
  }
  return {
    ok: true,
    state: {
      ...state === undefined ? {} : { state },
      scope: list(fields.get("scope")),
      dependsOn,
      extra: readExtras(fields)
    },
    warnings
  };
}
function locate(body) {
  const open = OPEN.exec(body);
  if (!open)
    return null;
  const innerStart = open.index + open[0].length;
  const end = body.indexOf(CLOSE, innerStart);
  if (end < 0)
    return { detail: "unterminated block" };
  const inner = body.slice(innerStart, end);
  if (inner.includes("<!--"))
    return { detail: "comment inside the block" };
  if (OPEN.test(body.slice(end + CLOSE.length)))
    return { detail: "more than one state block" };
  return { start: open.index, end: end + CLOSE.length, inner };
}
function parseStateBlock(body) {
  const found = locate(body);
  if (!found)
    return null;
  if ("detail" in found)
    return { ok: false, reason: "malformed", detail: found.detail };
  return readBlock(found.inner);
}
var breaksComment = (value) => /[\r\n]|-->/.test(value);
function invalid(field, detail) {
  return { ok: false, error: { reason: "invalid", field, detail } };
}
function validExtra(field) {
  if (!KEY.test(field.key) || KNOWN_FIELDS.has(field.key))
    return "bad key";
  if (breaksComment(field.value) || field.value !== field.value.trim())
    return "bad value";
  return null;
}
function renderStateBlock(state) {
  if (state.state !== undefined && !PR_STATES.includes(state.state))
    return invalid("state", "unknown state");
  for (const path of state.scope) {
    if (!path || path.includes(",") || breaksComment(path))
      return invalid("scope", path);
  }
  for (const ref of state.dependsOn) {
    if (!REF.test(ref))
      return invalid("depends-on", ref);
  }
  for (const field of state.extra) {
    const detail = validExtra(field);
    if (detail)
      return invalid(`extra:${field.key}`, detail);
  }
  const lines = ["<!-- crew-net"];
  if (state.state !== undefined)
    lines.push(`state: ${state.state}`);
  if (state.scope.length)
    lines.push(`scope: ${state.scope.join(", ")}`);
  if (state.dependsOn.length)
    lines.push(`depends-on: ${state.dependsOn.join(", ")}`);
  for (const { key, value } of state.extra)
    lines.push(`${key}: ${value}`);
  lines.push("-->");
  const block = lines.join(`
`);
  const matches = findClosingKeywords(block);
  if (matches.length)
    return { ok: false, error: { reason: "closing-keyword", matches } };
  return { ok: true, block };
}
function replaceStateBlock(body, state) {
  const found = locate(body);
  if (!found) {
    const rendered = renderStateBlock({ ...state, extra: [] });
    if (!rendered.ok)
      return rendered;
    const separator = body === "" ? "" : body.endsWith(`
`) ? `
` : `

`;
    return { ok: true, body: `${body}${separator}${rendered.block}
` };
  }
  if ("detail" in found)
    return {
      ok: false,
      error: { reason: "unreadable-block", detail: found.detail }
    };
  const existing = readBlock(found.inner);
  if (!existing.ok)
    return {
      ok: false,
      error: { reason: "unreadable-block", detail: existing.detail }
    };
  const rendered = renderStateBlock({ ...state, extra: existing.state.extra });
  if (!rendered.ok)
    return rendered;
  return {
    ok: true,
    body: body.slice(0, found.start) + rendered.block + body.slice(found.end)
  };
}
// src/app/commands/write/context.ts
class CommandError extends Error {
  code;
  constructor(code, message) {
    super(message);
    this.code = code;
    this.name = "CommandError";
  }
}
var same = (a, b) => a.toLowerCase() === b.toLowerCase();
var LOGIN2 = new RegExp(`^@(${LOGIN_PATTERN})$`);
var NUMBER = /^#?([1-9]\d{0,9})$/;
var QUALIFIED = /^([\w.-]+\/[\w.-]+)#([1-9]\d{0,9})$/;
var URL_REF = /^https:\/\/([^/\s]+)\/([\w.-]+\/[\w.-]+)\/(?:pull|issues)\/([1-9]\d{0,9})\/?$/;
function parseThreadRef(text, home) {
  const plain = NUMBER.exec(text);
  if (plain)
    return { repo: home.repo, number: Number(plain[1]) };
  const qualified = QUALIFIED.exec(text);
  if (qualified)
    return { repo: qualified[1], number: Number(qualified[2]) };
  const url = URL_REF.exec(text);
  if (url) {
    if ((url[1] ?? "").toLowerCase() !== home.host.toLowerCase())
      throw new CommandError("usage", `${text} is on ${url[1]}; crew-net works on ${home.host} only`);
    return { repo: url[2], number: Number(url[3]) };
  }
  return null;
}
function parseTarget(text, home) {
  const login = LOGIN2.exec(text);
  if (login)
    return { login: login[1] };
  const thread = parseThreadRef(text, home);
  if (thread)
    return { thread };
  throw new CommandError("usage", `expected @login, #N, owner/repo#N or a PR URL, got ${JSON.stringify(text)}`);
}
var label = (ref, home) => same(ref.repo, home) ? `#${ref.number}` : `${ref.repo}#${ref.number}`;
function guardKeywords(what, text) {
  const matches = findClosingKeywords(text);
  if (matches.length === 0)
    return;
  const list = matches.map((m) => `"${m.keyword} ${m.reference}" (line ${m.line})`).join(", ");
  throw new CommandError("closing-keyword", `${what} holds a closing keyword: ${list}. Reword it; link with "Refs #N"`);
}
async function currentWorktree(ctx) {
  const inside = (await ctx.git.worktreeBranches()).filter((t) => ctx.cwd === t.path || ctx.cwd.startsWith(`${t.path}/`)).sort((a, b) => b.path.length - a.path.length);
  return inside[0] ?? null;
}
async function currentPr(ctx, me) {
  const tree = await currentWorktree(ctx);
  if (!tree)
    return null;
  const pulls = await ctx.github.listOpenPulls(ctx.repo);
  return pulls.find((p) => p.headRef === tree.branch && same(p.author, me)) ?? null;
}
async function readPull(ctx, ref) {
  try {
    return await ctx.github.getPull(ref.repo, ref.number);
  } catch (error) {
    if (error.status === 404)
      throw new CommandError("not-found", `${label(ref, ctx.repo)} is not a pull request in ${ref.repo}`);
    throw error;
  }
}
// src/core/order/shell.ts
var SEPARATORS = new Set([";", "&", "|", `
`, "(", ")"]);
var DQ_ESCAPABLE = new Set(["$", "`", '"', "\\", `
`]);
var MAX_DEPTH = 8;

class Reader {
  src;
  depth;
  substitutionBody;
  i = 0;
  commands = [];
  current = [];
  word = null;
  bare = "";
  pendingHeredocs = [];
  redirectTarget = false;
  parens = 0;
  closedAt = -1;
  constructor(src, depth, substitutionBody = false) {
    this.src = src;
    this.depth = depth;
    this.substitutionBody = substitutionBody;
  }
  start() {
    this.word ??= { text: "", dynamic: false };
    return this.word;
  }
  append(text) {
    this.start().text += text;
  }
  markDynamic() {
    this.start().dynamic = true;
  }
  endWord() {
    if (this.word === null)
      return;
    if (/\{[^}]*(,|\.\.)[^}]*\}/.test(this.bare))
      this.word.dynamic = true;
    if (this.redirectTarget)
      this.redirectTarget = false;
    else
      this.current.push(this.word);
    this.word = null;
    this.bare = "";
  }
  endCommand() {
    this.endWord();
    const words = this.current.filter((w) => w.dynamic || !(w.text === "{" || w.text === "}"));
    if (words.length > 0)
      this.commands.push(words);
    this.current = [];
  }
  nested(body) {
    if (this.depth >= MAX_DEPTH)
      return "substitutions nest too deep";
    const inner = lex(body, this.depth + 1);
    if (!inner.ok)
      return inner.error;
    this.commands.push(...inner.commands);
    return null;
  }
  expansionsIn(text) {
    if (!/\$\(|`/.test(text))
      return null;
    return this.nested(`echo "${text.replaceAll('"', "\\\"")}"`);
  }
  substitution() {
    if (this.depth >= MAX_DEPTH)
      return "substitutions nest too deep";
    const inner = new Reader(this.src, this.depth + 1, true);
    inner.i = this.i + 2;
    const result = inner.run();
    if (!result.ok)
      return result.error;
    if (inner.closedAt < 0)
      return "unterminated substitution";
    this.commands.push(...result.commands);
    this.markDynamic();
    this.i = inner.closedAt + 1;
    return null;
  }
  backtick() {
    let body = "";
    for (let j = this.i + 1;j < this.src.length; j++) {
      const c = this.src.charAt(j);
      if (c === "\\" && j + 1 < this.src.length) {
        body += this.src.charAt(++j);
      } else if (c === "`") {
        this.markDynamic();
        this.i = j + 1;
        return this.nested(body);
      } else {
        body += c;
      }
    }
    return "unterminated backtick";
  }
  dollar() {
    const next = this.src.charAt(this.i + 1);
    if (next === "(")
      return this.substitution();
    if (next === "{") {
      const end = this.src.indexOf("}", this.i);
      if (end < 0)
        return "unterminated parameter expansion";
      this.markDynamic();
      const body = this.src.slice(this.i + 2, end);
      this.i = end + 1;
      return this.expansionsIn(body);
    }
    if (/[A-Za-z0-9_@*#?$!-]/.test(next)) {
      this.markDynamic();
      this.i += 2;
      if (/[A-Za-z_]/.test(next))
        while (/[A-Za-z0-9_]/.test(this.src.charAt(this.i)))
          this.i++;
      return null;
    }
    this.append("$");
    this.i++;
    return null;
  }
  singleQuoted() {
    const end = this.src.indexOf("'", this.i + 1);
    if (end < 0)
      return "unterminated quote";
    this.append(this.src.slice(this.i + 1, end));
    this.i = end + 1;
    return null;
  }
  ansiQuoted() {
    let text = "";
    for (let j = this.i + 2;j < this.src.length; j++) {
      const c = this.src.charAt(j);
      if (c === "'") {
        this.append(text);
        this.i = j + 1;
        return null;
      }
      if (c === "\\") {
        const e = this.src.charAt(++j);
        if (e === "'" || e === "\\")
          text += e;
        else
          this.markDynamic();
      } else {
        text += c;
      }
    }
    return "unterminated quote";
  }
  doubleQuoted() {
    this.start();
    this.i++;
    while (this.i < this.src.length) {
      const c = this.src.charAt(this.i);
      if (c === '"') {
        this.i++;
        return null;
      }
      if (c === "\\") {
        const e = this.src.charAt(this.i + 1);
        if (DQ_ESCAPABLE.has(e)) {
          if (e !== `
`)
            this.append(e);
        } else {
          this.append(`\\${e}`);
        }
        this.i += 2;
      } else if (c === "$") {
        const error = this.dollar();
        if (error)
          return error;
      } else if (c === "`") {
        const error = this.backtick();
        if (error)
          return error;
      } else {
        this.append(c);
        this.i++;
      }
    }
    return "unterminated quote";
  }
  redirect() {
    const c = this.src.charAt(this.i);
    const next = this.src.charAt(this.i + 1);
    if (next === "(")
      return this.substitution();
    if (this.word && !this.word.dynamic && /^\d+$/.test(this.word.text))
      this.word = null;
    this.endWord();
    if (c === "<" && next === "<") {
      if (this.src.charAt(this.i + 2) === "<") {
        this.i += 3;
      } else {
        const stripTabs = this.src.charAt(this.i + 2) === "-";
        this.i += stripTabs ? 3 : 2;
        const heredoc = this.heredocDelimiter(stripTabs);
        if (heredoc === null)
          return "missing here-document delimiter";
        if (!heredoc.quoted && /^\d+$/.test(heredoc.delimiter))
          return null;
        this.pendingHeredocs.push(heredoc);
        return null;
      }
    } else {
      this.i += next === ">" || next === "&" || next === "|" ? 2 : 1;
    }
    this.redirectTarget = true;
    return null;
  }
  heredocDelimiter(stripTabs) {
    while (this.src.charAt(this.i) === " " || this.src.charAt(this.i) === "\t")
      this.i++;
    const m = /^(?:'([^']*)'|"([^"]*)"|([^\s;&|<>()]+))/.exec(this.src.slice(this.i));
    if (!m)
      return null;
    this.i += m[0].length;
    const raw = m[1] ?? m[2] ?? m[3] ?? "";
    return {
      delimiter: raw.replaceAll("\\", ""),
      stripTabs,
      quoted: m[3] === undefined || raw.includes("\\")
    };
  }
  skipHeredocs() {
    for (const { delimiter, stripTabs, quoted } of this.pendingHeredocs) {
      let found = false;
      let body = "";
      while (this.i < this.src.length) {
        const eol = this.src.indexOf(`
`, this.i);
        const end = eol < 0 ? this.src.length : eol;
        let line = this.src.slice(this.i, end);
        if (stripTabs)
          line = line.replace(/^\t+/, "");
        this.i = end + 1;
        if (line === delimiter) {
          found = true;
          break;
        }
        body += `${line}
`;
      }
      if (!found)
        return "unterminated here-document";
      const error = quoted ? null : this.expansionsIn(body);
      if (error)
        return error;
    }
    this.pendingHeredocs = [];
    return null;
  }
  run() {
    const src = this.src;
    while (this.i < src.length) {
      const c = src.charAt(this.i);
      let error = null;
      if (c === "'") {
        error = this.singleQuoted();
      } else if (c === '"') {
        error = this.doubleQuoted();
      } else if (c === "$" && src.charAt(this.i + 1) === "'") {
        error = this.ansiQuoted();
      } else if (c === "$" && src.charAt(this.i + 1) === '"') {
        this.i++;
        error = this.doubleQuoted();
      } else if (this.substitutionBody && (c === "(" || c === ")")) {
        if (c === ")" && this.parens === 0) {
          this.closedAt = this.i;
          break;
        }
        this.parens += c === "(" ? 1 : -1;
        this.endCommand();
        this.i++;
      } else if (c === "$") {
        error = this.dollar();
      } else if (c === "`") {
        error = this.backtick();
      } else if (c === "\\") {
        const e = src.charAt(this.i + 1);
        if (e !== `
`)
          this.append(e);
        this.i += 2;
      } else if (c === "#" && this.word === null) {
        const eol = src.indexOf(`
`, this.i);
        this.i = eol < 0 ? src.length : eol;
      } else if (c === "<" || c === ">") {
        error = this.redirect();
      } else if (c === "&" && src.charAt(this.i + 1) === ">") {
        this.endWord();
        this.i += src.charAt(this.i + 2) === ">" ? 3 : 2;
        this.redirectTarget = true;
      } else if (SEPARATORS.has(c) || c === "\r") {
        this.endCommand();
        this.i++;
        if (c === `
`)
          error = this.skipHeredocs();
      } else if (c === " " || c === "\t") {
        this.endWord();
        this.i++;
      } else {
        if ("*?[".includes(c) || c === "~" && (this.word === null || /[=:]$/.test(this.bare)))
          this.markDynamic();
        this.append(c);
        this.bare += c;
        this.i++;
      }
      if (error)
        return { ok: false, error };
    }
    this.endCommand();
    return { ok: true, commands: this.commands };
  }
}
function lex(src, depth) {
  return new Reader(src, depth).run();
}
function lexShell(src) {
  return lex(src, 0);
}

