// src/cli/commands/sync.ts
var sync = {
  name: "sync",
  summary: "One sync pass: every due job (notifications, PRs, fetch, radar, deps)",
  usage: `Usage: crew-net sync [--once] [--detach] [--json] [--repo owner/repo]
  Runs one pass and exits; jobs that ran recently on this laptop are skipped.
  --detach starts the pass in the background and returns at once (for hooks).
  --once is accepted for clarity; a pass is always one pass.`,
  spec: { values: [], switches: ["--once", "--detach"] },
  async run(ctx) {
    if (ctx.args.positional.length > 0)
      throw new UsageError(`unexpected argument ${ctx.args.positional[0]}`);
    if (ctx.args.switches.has("--detach")) {
      ctx.runtime.detach([
        "sync",
        "--once",
        ...ctx.repo ? ["--repo", ctx.repo] : []
      ]);
      print(ctx, { detached: true }, "");
      return 0;
    }
    const ports = ctx.runtime.ports();
    const { here } = await locate2(ctx, ports);
    const report = await runSync(ports, here);
    const failed = report.jobs.filter((j) => j.outcome === "failed");
    const text = [
      ...failed.map((j) => `crew-net sync: ${j.job} failed: ${j.error}`),
      ...report.notice ? [report.notice] : []
    ];
    print(ctx, report, text.length ? `${text.join(`
`)}
` : "");
    return failed.length > 0 ? 1 : 0;
  }
};

// src/cli/commands/watch.ts
import { createInterface } from "node:readline";

// src/watch/index.ts
var TICK_MS = 30000;
async function runWatch(ports, sessionId, io, tickMs = TICK_MS) {
  const emit = (event) => io.write(`${encodeEvent(event)}
`);
  const watcher = new Watcher(ports, sessionId, emit);
  let queue = Promise.resolve();
  const serial = (fn) => {
    queue = queue.then(fn).catch((error) => emit({
      type: "error",
      message: error instanceof Error ? error.message : String(error)
    }));
    return queue;
  };
  let stop = () => {};
  const done = new Promise((resolve) => {
    stop = resolve;
  });
  io.stopped.then(() => stop(0));
  let ticking = false;
  const timer = setInterval(() => {
    if (!io.parentAlive()) {
      stop(0);
      return;
    }
    if (!watcher.started || ticking)
      return;
    ticking = true;
    serial(() => watcher.tick()).finally(() => {
      ticking = false;
    });
  }, tickMs);
  emit({ type: "ready" });
  (async () => {
    let helloSeen = false;
    for await (const line of io.lines) {
      if (!line.trim())
        continue;
      const decoded = decodeEvent(line);
      if (!decoded.ok) {
        emit({ type: "error", message: `bad event: ${decoded.detail}` });
        continue;
      }
      const event = decoded.event;
      if (event.type === "hello") {
        helloSeen = true;
        serial(() => watcher.start(event));
      } else if (event.type === "ack") {
        serial(() => watcher.ack(event));
      } else if (event.type === "bye") {
        await serial(() => watcher.bye());
        stop(0);
        return;
      } else {
        emit({ type: "error", message: `unexpected event ${event.type}` });
      }
    }
    if (!helloSeen) {
      emit({ type: "error", message: "stdin closed before hello" });
      stop(1);
    }
  })();
  const code = await done;
  clearInterval(timer);
  watcher.stop();
  await queue;
  return code;
}
async function sendToWatch(ports, sessionId, lines, report) {
  const watcher = new Watcher(ports, sessionId, () => {});
  let bad = 0;
  for await (const line of lines) {
    if (!line.trim())
      continue;
    const decoded = decodeEvent(line);
    if (!decoded.ok) {
      bad++;
      report(`bad event: ${decoded.detail}`);
      continue;
    }
    const event = decoded.event;
    if (event.type === "ack")
      await watcher.ack(event);
    else if (event.type === "bye")
      await watcher.bye();
    else {
      bad++;
      report(`unexpected event ${event.type}`);
    }
  }
  return bad;
}

// src/cli/commands/watch.ts
function alive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return error.code === "EPERM";
  }
}
var watch = {
  name: "watch",
  summary: "Watcher child of the Claude Code mod (NDJSON on stdin/stdout)",
  usage: `Usage: crew-net watch --session <id>
       crew-net watch send --session <id>
  watch: write ready, read hello on stdin (EOF after it is normal), then
  emit item/status/error events until bye, SIGTERM or the parent's death.
  send: read ack and bye lines on stdin, apply them, exit.`,
  spec: { values: ["--session"], switches: [] },
  async run(ctx) {
    const sessionId = single(ctx.args, "--session");
    if (!sessionId)
      throw new UsageError("--session is required");
    const [action, ...extra] = ctx.args.positional;
    if (extra.length > 0 || action !== undefined && action !== "send")
      throw new UsageError(`unexpected argument ${extra[0] ?? action}`);
    const lines = createInterface({
      input: process.stdin,
      crlfDelay: Infinity
    });
    try {
      if (action === "send") {
        const bad = await sendToWatch(ctx.runtime.ports(), sessionId, lines, (message) => ctx.io.err(`crew-net watch send: ${message}
`));
        return bad > 0 ? 1 : 0;
      }
      const parent = process.ppid;
      const stopped = new Promise((resolve) => {
        process.once("SIGTERM", () => resolve());
        process.once("SIGINT", () => resolve());
      });
      return await runWatch(ctx.runtime.ports(), sessionId, {
        lines,
        write: (line) => ctx.io.out(line),
        parentAlive: () => process.ppid === parent && parent !== 1 && alive(parent),
        stopped
      });
    } finally {
      lines.close();
    }
  }
};

// src/cli/commands/who.ts
import { isAbsolute as isAbsolute2, relative, resolve as resolve2 } from "node:path";
var who2 = {
  name: "who",
  summary: "Open work in watched repos that touches these paths",
  usage: `Usage: crew-net who [paths...] [--json] [--repo owner/repo]
  Paths are relative to the current directory. Without paths, lists all
  open work by others. Run it before starting work.`,
  spec: { values: [], switches: [] },
  async run(ctx) {
    const ports = ctx.runtime.ports();
    const { here, root } = await locate2(ctx, ports);
    const repos = new Map;
    if (here)
      repos.set(repoKey(here.ref), here.ref);
    if (!ctx.repo) {
      for (const key of Object.keys(await readWatched(ports.store))) {
        const ref = refFromKey(key);
        if (ref)
          repos.set(key, ref);
      }
    }
    const paths = ctx.args.positional.map((p) => {
      if (!root)
        return p;
      const rel = relative(root, resolve2(ctx.runtime.cwd, p));
      return rel.startsWith("..") || isAbsolute2(rel) ? p : rel || ".";
    });
    const entries = await who(ports.store, [...repos.values()], paths.map((p) => p === "." ? "" : p));
    print(ctx, entries, renderWho(entries));
    return 0;
  }
};

// src/cli/commands/index.ts
var COMMANDS = [
  digest,
  who2,
  inbox,
  stats2,
  doctor2,
  sync,
  session,
  watch
];

// src/cli/main.ts
var DEFAULT_COMMAND = "digest";
var VERSION = "0.1.0-dev";
function usage(commands) {
  const lines = commands.map((c) => `  ${c.name.padEnd(10)} ${c.summary}`);
  return [
    "Usage: crew-net <command> [--json] [--repo owner/repo] [args]",
    "",
    "Commands:",
    ...lines,
    "",
    "Run `crew-net <command> --help` for a command's flags.",
    ""
  ].join(`
`);
}
async function main(argv, runtime, io, commands = COMMANDS) {
  const first = argv[0];
  if (first === "--version") {
    io.out(`${VERSION}
`);
    return 0;
  }
  if (first === "--help" || first === "help") {
    io.out(usage(commands));
    return 0;
  }
  const named = first !== undefined && !first.startsWith("-");
  const name = named ? first : DEFAULT_COMMAND;
  const rest = named ? argv.slice(1) : argv;
  const command = commands.find((c) => c.name === name);
  if (!command) {
    io.err(`crew-net: unknown command ${name}

${usage(commands)}`);
    return 2;
  }
  try {
    const args = parseArgs(rest, mergeFlags(GLOBAL_FLAGS, command.spec));
    if (args.switches.has("--help")) {
      io.out(`${command.usage}
`);
      return 0;
    }
    const repos = args.values.get("--repo") ?? [];
    if (repos.length > 1)
      throw new UsageError("--repo given more than once");
    return await command.run({
      args,
      json: args.switches.has("--json"),
      repo: repos[0],
      runtime,
      io
    });
  } catch (error) {
    if (error instanceof UsageError) {
      io.err(`crew-net ${name}: ${error.message}
${command.usage}
`);
      return 2;
    }
    io.err(`crew-net ${name}: ${errorText(error)}
`);
    return 1;
  }
}
function errorText(error) {
  return error instanceof Error ? error.message : String(error);
}

// src/cli/runtime.ts
import { spawn } from "node:child_process";
import { readFileSync as readFileSync3 } from "node:fs";
import { homedir as homedir3 } from "node:os";
import { join as join5 } from "node:path";

// src/adapters/env/index.ts
import { execFile } from "node:child_process";
import { access, readdir, readFile } from "node:fs/promises";
import { homedir as homedir2, userInfo } from "node:os";
import { isAbsolute as isAbsolute3, join as join3 } from "node:path";
var run = (command, args, cwd) => new Promise((resolve, reject) => {
  execFile(command, args, {
    cwd,
    encoding: "utf8",
    timeout: 30000,
    maxBuffer: 1024 * 1024
  }, (error, stdout) => {
    if (error && typeof error.code !== "number") {
      reject(new Error(`${command} could not be executed`));
    } else {
      resolve({
        stdout,
        exitCode: typeof error?.code === "number" ? error.code : 0
      });
    }
  });
});
function defaultPolicySources(platform, user = () => userInfo().username) {
  if (platform === "darwin") {
    const dir = "/Library/Application Support/ClaudeCode";
    return [
      {
        kind: "plist",
        path: `/Library/Managed Preferences/${user()}/com.anthropic.claudecode.plist`
      },
      {
        kind: "plist",
        path: "/Library/Managed Preferences/com.anthropic.claudecode.plist"
      },
      { kind: "json-dir", path: `${dir}/managed-settings.d` },
      { kind: "json", path: `${dir}/managed-settings.json` }
    ];
  }
  if (platform === "linux")
    return [
      { kind: "json-dir", path: "/etc/claude-code/managed-settings.d" },
      { kind: "json", path: "/etc/claude-code/managed-settings.json" }
    ];
  return;
}

class EnvCommandError extends Error {
  constructor(command) {
    super(`${command} failed`);
    this.name = "EnvCommandError";
  }
}
function parseRepoIdentity(remote) {
  let host;
  let path;
  const scp = remote.match(/^[^/@\s]+@([^/:\s]+):(.*)$/);
  if (scp) {
    host = scp[1] ?? "";
    path = scp[2] ?? "";
  } else {
    let url;
    try {
      url = new URL(remote);
    } catch {
      throw new Error("Unsupported origin remote URL");
    }
    if (!["https:", "http:", "ssh:"].includes(url.protocol))
      throw new Error("Unsupported origin remote URL");
    host = url.hostname;
    path = url.pathname.replace(/^\//, "");
  }
  host = host.toLowerCase();
  if (host === "ssh.github.com")
    host = "github.com";
  if (!/^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$/.test(host))
    throw new Error("Origin remote has no valid host");
  path = path.replace(/\/$/, "").replace(/\.git$/, "");
  if (!/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(path))
    throw new Error("Origin remote must identify owner/repo");
  const [owner, repo] = path.split("/");
  if (owner === "." || owner === ".." || repo === "." || repo === "..")
    throw new Error("Invalid origin repository");
  return { host, repo: path };
}
var missing = (error) => error instanceof Error && ("code" in error) && (error.code === "ENOENT" || error.code === "ENOTDIR");
var unknown = (reason) => ({
  found: true,
  value: { status: "unknown", reason }
});
function fromSettings(raw) {
  if (typeof raw !== "object" || raw === null || Array.isArray(raw))
    return unknown("Managed policy is not an object");
  if (!("allowManagedHooksOnly" in raw))
    return { found: false };
  if (typeof raw.allowManagedHooksOnly !== "boolean")
    return unknown("Managed hooks policy is not boolean");
  return {
    found: true,
    value: { status: "known", enabled: raw.allowManagedHooksOnly }
  };
}

class EnvAdapter {
  options;
  runner;
  policySources;
  env;
  home;
  constructor(options) {
    this.options = options;
    this.runner = options.runner ?? run;
    this.policySources = options.policySources ?? defaultPolicySources(options.platform ?? process.platform);
    this.env = options.env ?? process.env;
    this.home = options.home ?? homedir2();
  }
  async command(command, args, cwd = this.options.repoDir) {
    let result;
    try {
      result = await this.runner(command, args, cwd);
    } catch {
      throw new EnvCommandError(command);
    }
    if (result.exitCode !== 0)
      throw new EnvCommandError(command);
    return result.stdout.trim();
  }
  async githubToken(host) {
    const token = await this.command("gh", [
      "auth",
      "token",
      "--hostname",
      host
    ]);
    if (!token)
      throw new EnvCommandError("gh");
    return token;
  }
  async repoIdentity(dir) {
    return parseRepoIdentity(await this.command("git", ["remote", "get-url", "origin"], dir));
  }
  xdg(variable, fallback) {
    const value = this.env[variable];
    return join3(value && isAbsolute3(value) ? value : join3(this.home, fallback), "crew-net");
  }
  stateDir() {
    return this.xdg("XDG_STATE_HOME", ".local/state");
  }
  configDir() {
    return this.xdg("XDG_CONFIG_HOME", ".config");
  }
  async plist(path) {
    try {
      await access(path);
    } catch (error) {
      if (missing(error))
        return { found: false };
      return unknown("Managed policy is inaccessible");
    }
    try {
      return fromSettings(JSON.parse(await this.command("plutil", ["-convert", "json", "-o", "-", path])));
    } catch {
      return unknown("Managed policy could not be read");
    }
  }
  async json(path) {
    let text;
    try {
      text = await readFile(path, "utf8");
    } catch (error) {
      if (missing(error))
        return { found: false };
      return unknown("Managed settings file is inaccessible");
    }
    try {
      return fromSettings(JSON.parse(text));
    } catch {
      return unknown("Managed settings file is not valid JSON");
    }
  }
  async jsonDir(path) {
    let names;
    try {
      names = await readdir(path);
    } catch (error) {
      if (missing(error))
        return { found: false };
      return unknown("Managed settings directory is inaccessible");
    }
    const files = names.filter((name) => name.endsWith(".json") && !name.startsWith(".")).sort().reverse();
    for (const name of files) {
      const lookup = await this.json(join3(path, name));
      if (lookup.found)
        return lookup;
    }
    return { found: false };
  }
  async managedHooksOnly() {
    if (!this.policySources)
      return {
        status: "unknown",
        reason: "Managed policy locations are unknown on this platform"
      };
    for (const source of this.policySources) {
      const lookup = source.kind === "plist" ? await this.plist(source.path) : source.kind === "json" ? await this.json(source.path) : await this.jsonDir(source.path);
      if (lookup.found)
        return lookup.value;
    }
    return { status: "known", enabled: false };
  }
}

// src/adapters/git/index.ts
import { execFile as execFile2 } from "node:child_process";
import { dirname } from "node:path";
var FETCH_TIMEOUT_MS = 120000;
var COMMAND_TIMEOUT_MS = 30000;
function gitEnv(base = process.env) {
  const { SSH_ASKPASS: _ssh, ...env } = base;
  return { ...env, GIT_ASKPASS: "", GIT_TERMINAL_PROMPT: "0" };
}
var runGit = (repoDir, args, timeoutMs) => new Promise((resolve, reject) => {
  execFile2("git", args, {
    cwd: repoDir,
    encoding: "utf8",
    maxBuffer: 64 * 1024 * 1024,
    timeout: timeoutMs,
    env: gitEnv()
  }, (error, stdout, stderr) => {
    if (error?.code === "ERR_CHILD_PROCESS_STDIO_MAXBUFFER") {
      reject(new Error("output exceeded 64 MiB"));
      return;
    }
    if (error?.killed) {
      reject(new Error(`timed out after ${timeoutMs / 1000} s`));
      return;
    }
    if (error && typeof error.code !== "number") {
      reject(error);
      return;
    }
    resolve({
      stdout,
      stderr,
      exitCode: typeof error?.code === "number" ? error.code : 0
    });
  });
});
function redact(text) {
  return text.replace(/(\w+:\/\/)[^/\s@]+@/g, "$1***@").replace(/\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_\w{20,})/g, "***");
}

class GitCommandError extends Error {
  args;
  exitCode;
  stderr;
  constructor(args, stderr, exitCode) {
    const clean = redact(stderr);
    super(redact(`git ${args.map((arg) => JSON.stringify(arg)).join(" ")} failed${clean ? `: ${clean.trim()}` : ""}`));
    this.args = args;
    this.exitCode = exitCode;
    this.name = "GitCommandError";
    this.stderr = clean;
  }
}
var NOREPLY = /^(?:\d+\+)?([A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)@users\.noreply\./i;
var MISSING_OBJECT = /does not exist|exists on disk, but not in|unknown revision|bad revision|invalid object name|not a valid object name/i;

class GitAdapter {
  repoDir;
  runner;
  constructor(repoDir, runner = runGit) {
    this.repoDir = repoDir;
    this.runner = runner;
  }
  async run(args, allowedExitCodes = [0], timeoutMs = COMMAND_TIMEOUT_MS) {
    let result;
    try {
      result = await this.runner(this.repoDir, args, timeoutMs);
    } catch (error) {
      throw new GitCommandError(args, error instanceof Error ? error.message : String(error), undefined);
    }
    if (!allowedExitCodes.includes(result.exitCode)) {
      throw new GitCommandError(args, result.stderr, result.exitCode);
    }
    return result;
  }
  async fetch() {
    await this.run(["fetch", "--prune", "origin"], [0], FETCH_TIMEOUT_MS);
  }
  async checkout() {
    const args = [
      "rev-parse",
      "--path-format=absolute",
      "--show-toplevel",
      "--git-common-dir"
    ];
    const { stdout } = await this.run(args);
    const [root, common] = stdout.split(`
`);
    if (!root || !common)
      throw new GitCommandError(args, "", 0);
    const head = await this.run(["symbolic-ref", "-q", "HEAD"], [0, 1]);
    const ref = head.stdout.trim();
    return {
      root,
      clone: dirname(common),
      ...ref.startsWith("refs/heads/") ? { branch: ref.slice("refs/heads/".length) } : {}
    };
  }
  async worktreeBranches() {
    const { stdout } = await this.run([
      "worktree",
      "list",
      "--porcelain",
      "-z"
    ]);
    const result = [];
    for (const record of stdout.split("\x00\x00")) {
      const fields = record.split("\x00");
      if (fields.includes("bare") || fields.includes("detached"))
        continue;
      const path = fields.find((field) => field.startsWith("worktree "));
      const branch = fields.find((field) => field.startsWith("branch refs/heads/"));
      if (path && branch)
        result.push({
          path: path.slice("worktree ".length),
          branch: branch.slice("branch refs/heads/".length)
        });
    }
    return result;
  }
  async remoteBranches() {
    const { stdout } = await this.run([
      "for-each-ref",
      "--format=%(refname:lstrip=3)%00%(symref)%00%(committerdate:iso-strict)",
      "refs/remotes/origin/"
    ]);
    const result = [];
    for (const line of stdout.split(`
`)) {
      if (!line)
        continue;
      const [name, symref, lastCommitAt] = line.split("\x00");
      if (!name || symref || !lastCommitAt)
        continue;
      result.push({ name, lastCommitAt });
    }
    return result;
  }
  async mergeBase(a, b) {
    const args = ["merge-base", "--end-of-options", a, b];
    const result = await this.run(args, [0, 1]);
    const base = result.stdout.trim();
    if (result.exitCode === 1 && !base && !result.stderr.trim())
      return;
    if (!/^(?:[0-9a-f]{40}|[0-9a-f]{64})$/.test(base))
      throw new GitCommandError(args, result.stderr, result.exitCode);
    return base;
  }
  async mergeTree(a, b) {
    const args = [
      "merge-tree",
      "--write-tree",
      "--name-only",
      "--no-messages",
      "-z",
      "--",
      a,
      b
    ];
    const result = await this.run(args, [0, 1]);
    const [tree, ...fields] = result.stdout.split("\x00");
    if (!tree || !/^(?:[0-9a-f]{40}|[0-9a-f]{64})$/.test(tree)) {
      throw new GitCommandError(args, result.stderr, result.exitCode);
    }
    const paths = fields.filter(Boolean);
    return { clean: result.exitCode === 0, conflictedPaths: paths };
  }
  async changedFiles(base, head) {
    const { stdout } = await this.run([
      "diff",
      "--name-only",
      "-z",
      "--no-ext-diff",
      "--no-textconv",
      "--no-renames",
      "--end-of-options",
      `${base}...${head}`,
      "--"
    ]);
    return stdout.split("\x00").filter(Boolean);
  }
  async showFile(ref, path) {
    const result = await this.run(["show", "--end-of-options", `${ref}:${path}`], [0, 128]);
    if (result.exitCode === 0)
      return result.stdout;
    if (MISSING_OBJECT.test(result.stderr))
      return;
    throw new GitCommandError(["show", `${ref}:${path}`], result.stderr, result.exitCode);
  }
  async branchAuthor(base, tip) {
    const { stdout } = await this.run([
      "log",
      "--first-parent",
      "--no-merges",
      "--max-count=1",
      "--format=%ae",
      "--end-of-options",
      `${base}..${tip}`,
      "--"
    ]);
    const authorEmail = stdout.trim();
    if (!authorEmail)
      return;
    return {
      authorEmail,
      loginHint: authorEmail.match(NOREPLY)?.[1] ?? null
    };
  }
  async landed(from, to) {
    const { stdout } = await this.run([
      "log",
      "--first-parent",
      "-m",
      "--no-renames",
      "--name-only",
      "-z",
      "--max-count=100",
      "--format=%x01%H%x02%ae%x02%s",
      "--end-of-options",
      `${from}..${to}`,
      "--"
    ]);
    const result = [];
    for (const record of stdout.split("\x01").slice(1)) {
      const end = record.indexOf("\x00");
      const head = end === -1 ? record : record.slice(0, end);
      const rest = end === -1 ? "" : record.slice(end + 1).replace(/^\n/, "");
      const [sha, authorEmail = "", subject = ""] = head.split("\x02");
      if (!sha)
        continue;
      result.push({
        sha,
        subject,
        authorEmail,
        loginHint: authorEmail.match(NOREPLY)?.[1] ?? null,
        paths: rest.split("\x00").filter(Boolean)
      });
    }
    return result;
  }
}

// src/adapters/github/index.ts
var WRITE_WINDOWS = [
  { windowMs: 60000, max: 20 },
  { windowMs: 3600000, max: 200 }
];
var SECONDARY_BACKOFF_MS = 60000;
var REQUEST_TIMEOUT_MS = 30000;
var MERGED_LIMIT = 50;
var REASONS = new Set([
  "mention",
  "team_mention",
  "author",
  "comment",
  "review_requested",
  "assign"
]);

class AuthError extends Error {
  host;
  constructor(host) {
    super(`GitHub authentication failed for ${host}. Run: gh auth refresh --hostname ${host}`);
    this.host = host;
    this.name = "AuthError";
  }
}

class SsoError extends Error {
  host;
  authorizeUrl;
  constructor(host, authorizeUrl) {
    super(`GitHub SSO authorization required on ${host}. ${authorizeUrl ? `Authorize the token: ${authorizeUrl}` : `Run: gh auth refresh --hostname ${host}`}`);
    this.host = host;
    this.authorizeUrl = authorizeUrl;
    this.name = "SsoError";
  }
}

class RateLimitError extends Error {
  retryAfterMs;
  secondary;
  constructor(retryAfterMs, secondary) {
    super(`GitHub ${secondary ? "secondary " : ""}rate limit reached; retry in ${Math.ceil(retryAfterMs / 1000)} s`);
    this.retryAfterMs = retryAfterMs;
    this.secondary = secondary;
    this.name = "RateLimitError";
  }
}

class BudgetError extends Error {
  retryAfterMs;
  constructor(retryAfterMs) {
    super(`crew-net write budget exhausted (20/min, 200/h); retry in ${Math.ceil(retryAfterMs / 1000)} s`);
    this.retryAfterMs = retryAfterMs;
    this.name = "BudgetError";
  }
}

class GitHubResponseError extends Error {
  status;
  constructor(status, message = "GitHub request failed") {
    super(`${message} (HTTP ${status})`);
    this.status = status;
    this.name = "GitHubResponseError";
  }
}
function validHost(host) {
  if (!/^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$/.test(host))
    throw new Error("Invalid GitHub host");
  return host;
}
function apiUrls(host) {
  validHost(host);
  if (host === "github.com")
    return {
      rest: "https://api.github.com",
      graphql: "https://api.github.com/graphql"
    };
  if (host.endsWith(".ghe.com"))
    return {
      rest: `https://api.${host}`,
      graphql: `https://api.${host}/graphql`
    };
  return {
    rest: `https://${host}/api/v3`,
    graphql: `https://${host}/api/graphql`
  };
}
function object(value) {
  if (typeof value !== "object" || value === null || Array.isArray(value))
    throw new Error("Invalid GitHub object");
  return value;
}
function string(value) {
  if (typeof value !== "string")
    throw new Error("Invalid GitHub string");
  return value;
}
function integer(value) {
  if (typeof value !== "number" || !Number.isSafeInteger(value) || value < 1)
    throw new Error("Invalid GitHub identifier");
  return value;
}
function boolean2(value) {
  if (typeof value !== "boolean")
    throw new Error("Invalid GitHub boolean");
  return value;
}
function login(value) {
  return value === null ? "ghost" : string(object(value).login);
}
function repoPath(repo) {
  const parts = repo.split("/");
  const [owner, name] = parts;
  if (parts.length !== 2 || !owner || !name || !/^[A-Za-z0-9_.-]+$/.test(owner) || !/^[A-Za-z0-9_.-]+$/.test(name) || owner === "." || owner === ".." || name === "." || name === "..")
    throw new Error("Repository must be owner/repo");
  return `/repos/${owner}/${name}`;
}
function pull(value) {
  const raw = object(value);
  const head = object(raw.head);
  const state = string(raw.state);
  if (state !== "open" && state !== "closed")
    throw new Error("Invalid GitHub pull state");
  return {
    number: integer(raw.number),
    nodeId: string(raw.node_id),
    title: string(raw.title),
    author: login(raw.user),
    headRef: string(head.ref),
    headSha: string(head.sha),
    ...head.repo === undefined ? {} : {
      headRepo: head.repo === null ? "" : string(object(head.repo).full_name)
    },
    baseRef: string(object(raw.base).ref),
    state,
    draft: boolean2(raw.draft),
    body: raw.body === null ? "" : string(raw.body),
    updatedAt: string(raw.updated_at),
    autoMerge: raw.auto_merge != null,
    merged: raw.merged === undefined ? false : boolean2(raw.merged)
  };
}
function comment(value) {
  const raw = object(value);
  const issue = new URL(string(raw.issue_url)).pathname.match(/\/issues\/(\d+)$/)?.[1];
  if (!issue)
    throw new Error("Invalid GitHub comment issue URL");
  return {
    id: integer(raw.id),
    issueNumber: integer(Number(issue)),
    author: login(raw.user),
    body: string(raw.body),
    createdAt: string(raw.created_at),
    updatedAt: string(raw.updated_at),
    url: string(raw.html_url)
  };
}
function review(value) {
  const raw = object(value);
  return {
    id: integer(raw.id),
    author: login(raw.user),
    state: string(raw.state),
    body: raw.body == null ? "" : string(raw.body),
    submittedAt: raw.submitted_at == null ? null : string(raw.submitted_at),
    url: string(raw.html_url)
  };
}
function thread(value) {
  const raw = object(value);
  const reason = string(raw.reason);
  if (!REASONS.has(reason))
    return;
  const subject = object(raw.subject);
  const type = string(subject.type);
  const kind = type === "PullRequest" ? "pull" : type === "Issue" ? "issue" : undefined;
  if (!kind || typeof subject.url !== "string")
    return;
  const number = new URL(subject.url).pathname.match(/\/(?:pulls|issues)\/(\d+)$/)?.[1];
  if (!number)
    throw new Error("Invalid GitHub notification subject URL");
  return {
    threadId: string(raw.id),
    repo: string(object(raw.repository).full_name),
    kind,
    number: integer(Number(number)),
    reason,
    updatedAt: string(raw.updated_at)
  };
}
function compareCursor(a, b) {
  return Date.parse(a.updatedAt) - Date.parse(b.updatedAt) || a.id - b.id;
}
function cacheKey(url) {
  const parsed = new URL(url);
  if (parsed.pathname.endsWith("/notifications"))
    parsed.searchParams.delete("since");
  return `github:cache:${parsed.href}`;
}
var writesKey = (host) => `github:writes:${host}`;
var blockedKey = (host) => `github:blocked:${host}`;
function cached(value) {
  if (typeof value !== "object" || value === null || Array.isArray(value))
    return;
  const { etag, lastModified, body, next } = value;
  if (body === undefined)
    return;
  if (typeof etag !== "string" && typeof lastModified !== "string")
    return;
  return {
    ...typeof etag === "string" ? { etag } : {},
    ...typeof lastModified === "string" ? { lastModified } : {},
    body,
    ...typeof next === "string" ? { next } : {}
  };
}
function budgetWait(log, now) {
  const waits = WRITE_WINDOWS.flatMap(({ windowMs, max }) => {
    const inside = log.filter((at) => at > now - windowMs);
    return inside.length >= max ? [(inside[0] ?? now) + windowMs - now] : [];
  });
  return waits.length ? Math.max(...waits) : 0;
}
var LONGEST_WINDOW_MS = Math.max(...WRITE_WINDOWS.map((w) => w.windowMs));
function ssoPartial(response) {
  const sso = response.headers.get("x-github-sso");
  if (!sso?.startsWith("partial-results"))
    return [];
  return (sso.match(/organizations=([^;\s]+)/)?.[1] ?? "").split(",").filter(Boolean);
}

class GitHubAdapter {
  options;
  host;
  rest;
  graphql;
  fetcher;
  now;
  token;
  reread = false;
  authFailure;
  stats = {
    requests: 0,
    notModified: 0,
    writes: 0,
    rateLimitRemaining: null
  };
  constructor(options) {
    this.options = options;
    this.host = validHost(options.host);
    ({ rest: this.rest, graphql: this.graphql } = apiUrls(this.host));
    this.fetcher = options.fetch ?? globalThis.fetch;
    this.now = options.now ?? Date.now;
  }
  requestStats() {
    return { ...this.stats };
  }
  async currentToken() {
    this.token ??= this.options.tokenProvider().then((token) => {
      if (!token)
        throw new Error("empty token");
      return token;
    });
    try {
      return await this.token;
    } catch {
      this.authFailure = new AuthError(this.host);
      throw this.authFailure;
    }
  }
  nextLink(response, url) {
    const next = response.headers.get("link")?.split(",").find((part) => /rel="next"/.test(part))?.match(/<([^>]+)>/)?.[1];
    if (!next)
      return;
    return new URL(next, url).href;
  }
  async backOff(ms, secondary) {
    const wait = Number.isFinite(ms) ? Math.max(0, ms) : SECONDARY_BACKOFF_MS;
    await this.options.kv.set(blockedKey(this.host), {
      until: this.now() + wait,
      secondary
    });
    throw new RateLimitError(wait, secondary);
  }
  async blocked() {
    const value = await this.options.kv.get(blockedKey(this.host));
    if (typeof value !== "object" || value === null || Array.isArray(value))
      return;
    const wait = (typeof value.until === "number" ? value.until : 0) - this.now();
    if (wait > 0)
      throw new RateLimitError(wait, value.secondary === true);
  }
  async limited(response) {
    if (response.status !== 403 && response.status !== 429)
      return;
    const sso = response.headers.get("x-github-sso");
    if (response.status === 403 && sso?.startsWith("required"))
      throw new SsoError(this.host, sso.match(/url=(\S+)/)?.[1]);
    const now = this.now();
    const retry = response.headers.get("retry-after");
    const remaining = response.headers.get("x-ratelimit-remaining");
    if (retry !== null) {
      const secondary = remaining !== "0";
      await this.backOff(/^\d+(\.\d+)?$/.test(retry) ? Number(retry) * 1000 : Date.parse(retry) - now, secondary);
    }
    if (remaining === "0") {
      const reset = Number(response.headers.get("x-ratelimit-reset"));
      await this.backOff(reset > 0 ? reset * 1000 - now : SECONDARY_BACKOFF_MS, false);
    }
    if (response.status === 429)
      await this.backOff(SECONDARY_BACKOFF_MS, true);
    const text = await response.text().catch(() => "");
    if (/secondary rate limit|abuse detection/i.test(text))
      await this.backOff(SECONDARY_BACKOFF_MS, true);
  }
  async request(url, call = {}) {
    if (this.authFailure)
      throw this.authFailure;
    await this.blocked();
    const method = call.method ?? "GET";
    if (call.budgeted) {
      const now = this.now();
      let wait = 0;
      await this.options.kv.update(writesKey(this.host), (current) => {
        const log = (Array.isArray(current) ? current : []).filter((at) => typeof at === "number").filter((at) => at > now - LONGEST_WINDOW_MS).sort((a, b) => a - b);
        wait = budgetWait(log, now);
        return wait > 0 ? log : [...log, now];
      });
      if (wait > 0)
        throw new BudgetError(wait);
    }
    const hit = method === "GET" ? cached(await this.options.kv.get(cacheKey(url))) : undefined;
    for (;; ) {
      const token = await this.currentToken();
      const used = this.token;
      const headers = {
        Accept: "application/vnd.github+json",
        Authorization: `Bearer ${token}`,
        "X-GitHub-Api-Version": "2022-11-28"
      };
      if (hit?.etag)
        headers["If-None-Match"] = hit.etag;
      if (hit?.lastModified)
        headers["If-Modified-Since"] = hit.lastModified;
      if (call.body !== undefined)
        headers["Content-Type"] = "application/json";
      this.stats.requests++;
      if (method !== "GET")
        this.stats.writes++;
      const response = await this.fetcher(url, {
        method,
        headers,
        redirect: "error",
        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
        ...call.body === undefined ? {} : { body: JSON.stringify(call.body) }
      });
      const remaining = response.headers.get("x-ratelimit-remaining");
      if (url !== this.graphql && remaining !== null && /^\d+$/.test(remaining))
        this.stats.rateLimitRemaining = Number(remaining);
      if (response.status === 401) {
        if (this.token !== undefined && used !== this.token)
          continue;
        if (this.reread) {
          this.authFailure = new AuthError(this.host);
          throw this.authFailure;
        }
        this.reread = true;
        this.token = undefined;
        continue;
      }
      await this.limited(response);
      const poll = response.headers.get("x-poll-interval");
      const pollIntervalMs = poll && /^\d+$/.test(poll) ? Number(poll) * 1000 : null;
      if (response.status === 304) {
        this.stats.notModified++;
        if (!hit)
          throw new GitHubResponseError(304, "GitHub returned 304 without a cached body");
        return {
          body: hit.body,
          ...hit.next === undefined ? {} : { next: hit.next },
          modified: false,
          pollIntervalMs,
          ssoPartial: ssoPartial(response)
        };
      }
      if (!response.ok)
        throw new GitHubResponseError(response.status);
      let body = null;
      if (response.status !== 204) {
        try {
          body = await response.json();
        } catch {
          throw new GitHubResponseError(response.status, "Invalid GitHub JSON");
        }
      }
      const next = this.nextLink(response, url);
      if (method === "GET") {
        const etag = response.headers.get("etag");
        const lastModified = response.headers.get("last-modified");
        if (etag || lastModified)
          await this.options.kv.set(cacheKey(url), {
            ...etag ? { etag } : {},
            ...lastModified ? { lastModified } : {},
            body,
            ...next === undefined ? {} : { next }
          });
      }
      return {
        body,
        ...next === undefined ? {} : { next },
        modified: true,
        pollIntervalMs,
        ssoPartial: ssoPartial(response)
      };
    }
  }
  async pages(url, stop = () => false) {
    const items = [];
    const visited = new Set;
    const sso = new Set;
    const origin = new URL(url).origin;
    let modified = false;
    let pollIntervalMs = null;
    let next = url;
    while (next) {
      if (new URL(next).origin !== origin)
        throw new Error("Invalid GitHub pagination URL");
      if (visited.has(next))
        throw new Error("GitHub pagination cycle");
      visited.add(next);
      const page = await this.request(next);
      if (!Array.isArray(page.body))
        throw new Error("Invalid GitHub list");
      modified ||= page.modified;
      pollIntervalMs ??= page.pollIntervalMs;
      for (const org of page.ssoPartial)
        sso.add(org);
      items.push(...page.body);
      if (stop(page.body))
        break;
      next = page.next;
    }
    return { items, modified, pollIntervalMs, ssoPartial: [...sso] };
  }
  async list(url, parse) {
    return (await this.pages(url)).items.map(parse);
  }
  async notifications(since) {
    const query = new URLSearchParams({ all: "true", since, per_page: "50" });
    const after = Date.parse(since);
    if (!Number.isFinite(after))
      throw new Error("Invalid notifications since");
    const { items, modified, pollIntervalMs, ssoPartial } = await this.pages(`${this.rest}/notifications?${query}`);
    return {
      modified,
      threads: items.flatMap((value) => thread(value) ?? []).filter((t) => Date.parse(t.updatedAt) >= after),
      pollIntervalMs,
      ssoPartialOrgs: ssoPartial
    };
  }
  async listOpenPulls(repo) {
    return this.list(`${this.rest}${repoPath(repo)}/pulls?state=open&per_page=100`, pull);
  }
  async listMergedPulls(repo, sinceIso) {
    const since = Date.parse(sinceIso);
    if (!Number.isFinite(since))
      throw new Error("Invalid merged-since date");
    const result = [];
    await this.pages(`${this.rest}${repoPath(repo)}/pulls?state=closed&sort=updated&direction=desc&per_page=100`, (page) => {
      for (const value of page) {
        const raw = object(value);
        if (Date.parse(string(raw.updated_at)) < since)
          return true;
        if (raw.merged_at == null)
          continue;
        const mergedAt = string(raw.merged_at);
        if (Date.parse(mergedAt) < since)
          continue;
        result.push({ ...pull(value), merged: true, mergedAt });
        if (result.length === MERGED_LIMIT)
          return true;
      }
      return false;
    });
    return result;
  }
  async viewer() {
    return login((await this.request(`${this.rest}/user`)).body);
  }
  async getPull(repo, number) {
    return pull((await this.request(`${this.rest}${repoPath(repo)}/pulls/${integer(number)}`)).body);
  }
  async listPullFiles(repo, number) {
    const files = await this.list(`${this.rest}${repoPath(repo)}/pulls/${integer(number)}/files?per_page=100`, (value) => {
      const raw = object(value);
      return raw.previous_filename === undefined ? [string(raw.filename)] : [string(raw.filename), string(raw.previous_filename)];
    });
    return files.flat();
  }
  async defaultBranch(repo) {
    const branch = string(object((await this.request(`${this.rest}${repoPath(repo)}`)).body).default_branch);
    if (branch === "")
      throw new Error("Invalid GitHub default branch");
    return branch;
  }
  async threadState(repo, number) {
    const raw = object((await this.request(`${this.rest}${repoPath(repo)}/issues/${integer(number)}`)).body);
    const state = string(raw.state);
    if (state === "open")
      return "open";
    if (state !== "closed")
      throw new Error("Invalid GitHub issue state");
    return raw.pull_request != null && object(raw.pull_request).merged_at != null ? "merged" : "closed";
  }
  async listThreadComments(repo, number, cursor) {
    const query = new URLSearchParams({
      since: cursor.updatedAt,
      per_page: "100"
    });
    const comments = await this.list(`${this.rest}${repoPath(repo)}/issues/${integer(number)}/comments?${query}`, comment);
    if (!Number.isFinite(Date.parse(cursor.updatedAt)))
      throw new Error("Invalid comment cursor");
    return comments.filter((c) => compareCursor(c, cursor) > 0).sort(compareCursor);
  }
  async listReviews(repo, number) {
    return this.list(`${this.rest}${repoPath(repo)}/pulls/${integer(number)}/reviews?per_page=100`, review);
  }
  async postComment(repo, number, body) {
    await this.request(`${this.rest}${repoPath(repo)}/issues/${integer(number)}/comments`, { method: "POST", body: { body }, budgeted: true });
  }
  async updatePullBody(repo, number, body) {
    await this.request(`${this.rest}${repoPath(repo)}/pulls/${integer(number)}`, { method: "PATCH", body: { body }, budgeted: true });
  }
  async createIssue(repo, title, body) {
    const page = await this.request(`${this.rest}${repoPath(repo)}/issues`, {
      method: "POST",
      body: { title, body },
      budgeted: true
    });
    return integer(object(page.body).number);
  }
  async disableAutoMerge(repo, number) {
    const pr = await this.getPull(repo, number);
    if (!pr.autoMerge)
      return;
    const response = object((await this.request(this.graphql, {
      method: "POST",
      body: {
        query: "mutation($id: ID!) { disablePullRequestAutoMerge(input: {pullRequestId: $id}) { pullRequest { id } } }",
        variables: { id: pr.nodeId }
      }
    })).body);
    if (response.errors !== undefined || response.data == null)
      throw new GitHubResponseError(200, "GitHub GraphQL mutation failed");
    const mutation = object(object(response.data).disablePullRequestAutoMerge);
    if (object(mutation.pullRequest).id !== pr.nodeId)
      throw new GitHubResponseError(200, "Invalid GitHub GraphQL mutation result");
  }
}

// src/adapters/store/index.ts
import { createHash, randomUUID } from "node:crypto";
import {
  appendFileSync,
  chmodSync,
  closeSync,
  fsyncSync,
  linkSync,
  mkdirSync,
  openSync,
  readdirSync as readdirSync2,
  readFileSync as readFileSync2,
  renameSync,
  statSync,
  unlinkSync,
  writeFileSync
} from "node:fs";
import { dirname as dirname2, isAbsolute as isAbsolute4, join as join4 } from "node:path";
import { setTimeout } from "node:timers/promises";
var RETENTION_MS = 14 * 24 * 60 * 60 * 1000;
var SESSION_LIVE_MS = 3 * 60 * 1000;
var JOB_LOCK_TTL_MS = 10 * 60 * 1000;
var MUTEX_TTL_MS = 30 * 1000;
var EVENTS_ROTATE_BYTES = 10 * 1024 * 1024;
var DIRS = ["inbox", "delivered", "sessions", "repos", "locks", "kv"];
var TEMP = /\.(\d+)\.[0-9a-f-]{36}\.tmp$/;
var SEGMENT2 = /^[A-Za-z0-9_.-]+$/;
var HASHED = /^[0-9a-f]{64}$/;
var HASHED_JSON = /^[0-9a-f]{64}\.json$/;
var MARKER2 = /^recovery-([0-9a-f-]{36})$/;
var LOCK = /^[0-9a-f]{64}\.lock$/;
function defaultStateDir(env, home) {
  const xdg = env.XDG_STATE_HOME;
  return join4(xdg && isAbsolute4(xdg) ? xdg : join4(home, ".local", "state"), "crew-net");
}

class StoreFormatError extends Error {
  constructor(path) {
    super(`Invalid crew-net store data: ${path}`);
    this.name = "StoreFormatError";
  }
}

class StoreLockError extends Error {
  constructor(path) {
    super(`Crew-net store lock is busy or invalid: ${path}`);
    this.name = "StoreLockError";
  }
}
function isCode(error, code) {
  return error instanceof Error && "code" in error && error.code === code;
}
function hash(id) {
  if (!id)
    throw new Error("Store ids must not be empty");
  return createHash("sha256").update(id).digest("hex");
}
function fields(value) {
  return typeof value === "object" && value !== null && !Array.isArray(value) ? value : undefined;
}
var isString2 = (v) => typeof v === "string";
var isTime = (v) => typeof v === "number" && Number.isSafeInteger(v) && v >= 0;
var isPid = (v) => typeof v === "number" && Number.isInteger(v) && v > 0 && v <= 2147483647;
function parseOwner(value) {
  const raw = fields(value);
  if (!raw || !isPid(raw.pid) || !isString2(raw.token) || !/^[0-9a-f-]{36}$/.test(raw.token) || !isTime(raw.expiresAtMs))
    return;
  return { pid: raw.pid, token: raw.token, expiresAtMs: raw.expiresAtMs };
}
function parseClaim(value) {
  const raw = fields(value);
  if (!raw || !isString2(raw.sessionId) || !isTime(raw.atMs))
    return;
  return { sessionId: raw.sessionId, atMs: raw.atMs };
}
function parseItem(value) {
  const parsed = decodeEvent(JSON.stringify(value));
  return parsed.ok && parsed.event.type === "item" ? parsed.event : undefined;
}
function parseStored(value) {
  const raw = fields(value);
  const item = parseItem(raw?.item);
  if (!raw || !item || !isTime(raw.receivedAtMs))
    return;
  return { item, receivedAtMs: raw.receivedAtMs };
}
function parseRequest(value) {
  const raw = fields(value);
  if (!raw || !isString2(raw.id) || !isString2(raw.repo) || !isPid(raw.number) || !isString2(raw.to) || !isString2(raw.kind) || !isString2(raw.text) || !isTime(raw.createdAtMs) || raw.status !== "open" && raw.status !== "in-progress")
    return;
  return {
    id: raw.id,
    repo: raw.repo,
    number: raw.number,
    to: raw.to,
    kind: raw.kind,
    text: raw.text,
    createdAtMs: raw.createdAtMs,
    status: raw.status
  };
}
function parseSession(value) {
  const raw = fields(value);
  if (!raw || !isString2(raw.sessionId) || !isPid(raw.pid) || !isString2(raw.harness) || raw.role !== "lead" && raw.role !== "worker" || !isString2(raw.worktree) || !isTime(raw.seenAtMs) || raw.clone !== undefined && !isString2(raw.clone) || raw.repo !== undefined && !isString2(raw.repo) || raw.branch !== undefined && !isString2(raw.branch) || raw.lastPromptAtMs !== undefined && !isTime(raw.lastPromptAtMs))
    return;
  const session = {
    sessionId: raw.sessionId,
    pid: raw.pid,
    harness: raw.harness,
    role: raw.role,
    worktree: raw.worktree,
    seenAtMs: raw.seenAtMs
  };
  if (raw.clone !== undefined)
    session.clone = raw.clone;
  if (raw.repo !== undefined)
    session.repo = raw.repo;
  if (raw.branch !== undefined)
    session.branch = raw.branch;
  if (raw.lastPromptAtMs !== undefined)
    session.lastPromptAtMs = raw.lastPromptAtMs;
  return session;
}
function parseCursors(value) {
  const raw = fields(value);
  const cursors = fields(raw?.cursors);
  const lastRun = fields(raw?.lastRun);
  if (!cursors || !lastRun)
    return;
  const c = Object.entries(cursors);
  const l = Object.entries(lastRun);
  if (!c.every(([, v]) => isString2(v)) || !l.every(([, v]) => isTime(v)))
    return;
  return {
    cursors: new Map(c),
    lastRun: new Map(l)
  };
}

class FileStoreAdapter {
  root;
  clock;
  constructor(root, clock) {
    this.root = root;
    this.clock = clock;
    for (const dir of [root, ...DIRS.map((d) => join4(root, d))])
      this.ensureDir(dir);
  }
  ensureDir(dir) {
    mkdirSync(dir, { recursive: true, mode: 448 });
    chmodSync(dir, 448);
  }
  path(...parts) {
    return join4(this.root, ...parts);
  }
  read(path, parse) {
    let text;
    try {
      text = readFileSync2(path, "utf8");
    } catch (error) {
      if (isCode(error, "ENOENT"))
        return;
      throw error;
    }
    let value;
    try {
      value = JSON.parse(text);
    } catch {
      throw new StoreFormatError(path);
    }
    const parsed = parse(value);
    if (parsed === undefined)
      throw new StoreFormatError(path);
    return parsed;
  }
  write(path, value) {
    const temp = `${path}.${process.pid}.${randomUUID()}.tmp`;
    try {
      const fd = openSync(temp, "wx", 384);
      try {
        writeFileSync(fd, JSON.stringify(value));
        fsyncSync(fd);
      } finally {
        closeSync(fd);
      }
      renameSync(temp, path);
      this.syncDir(path);
    } finally {
      this.remove(temp);
    }
  }
  remove(path) {
    try {
      unlinkSync(path);
    } catch (error) {
      if (!isCode(error, "ENOENT"))
        throw error;
    }
  }
  names(dir, pattern) {
    return readdirSync2(dir).filter((name) => pattern.test(name)).sort();
  }
  syncDir(path) {
    const dir = openSync(dirname2(path), "r");
    try {
      fsyncSync(dir);
    } finally {
      closeSync(dir);
    }
  }
  publish(path, value, token) {
    const temp = `${path}.${process.pid}.${token}.tmp`;
    try {
      const fd = openSync(temp, "wx", 384);
      try {
        writeFileSync(fd, JSON.stringify(value));
        fsyncSync(fd);
      } finally {
        closeSync(fd);
      }
      try {
        linkSync(temp, path);
      } catch (error) {
        if (isCode(error, "EEXIST"))
          return false;
        throw error;
      }
      this.syncDir(path);
      return true;
    } finally {
      this.remove(temp);
    }
  }
  alive(pid) {
    try {
      process.kill(pid, 0);
      return true;
    } catch (error) {
      if (isCode(error, "ESRCH"))
        return false;
      if (isCode(error, "EPERM"))
        return true;
      throw error;
    }
  }
  stale(owner) {
    return this.clock.now() >= owner.expiresAtMs || !this.alive(owner.pid);
  }
  readOwner(path) {
    try {
      return this.read(path, parseOwner);
    } catch (error) {
      if (error instanceof StoreFormatError)
        throw new StoreLockError(path);
      throw error;
    }
  }
  recover(path, stale, owner) {
    let token = stale.token;
    const visited = new Set;
    for (;; ) {
      if (visited.has(token))
        throw new StoreLockError(path);
      visited.add(token);
      const marker = this.path("locks", `recovery-${token}`);
      const reaperRecord = {
        ...owner,
        expiresAtMs: this.clock.now() + MUTEX_TTL_MS
      };
      if (this.publish(marker, reaperRecord, owner.token)) {
        if (this.readOwner(path)?.token === stale.token)
          this.remove(path);
        return;
      }
      const reaper = this.readOwner(marker);
      if (!reaper || !this.stale(reaper))
        return;
      token = reaper.token;
    }
  }
  tryLock(path, ttlMs) {
    const owner = {
      pid: process.pid,
      token: randomUUID(),
      expiresAtMs: this.clock.now() + ttlMs
    };
    for (let attempt = 0;attempt < 3; attempt++) {
      if (this.publish(path, owner, owner.token))
        return owner;
      const held = this.readOwner(path);
      if (held === undefined)
        continue;
      if (!this.stale(held))
        return;
      this.recover(path, held, owner);
    }
    return;
  }
  unlock(path, owner) {
    if (this.readOwner(path)?.token === owner.token)
      this.remove(path);
  }
  lockPath(name) {
    return this.path("locks", `${hash(name)}.lock`);
  }
  async locked(name, change) {
    const path = this.lockPath(`mutex:${name}`);
    for (let attempt = 0;attempt < 200; attempt++) {
      const owner = this.tryLock(path, MUTEX_TTL_MS);
      if (owner) {
        try {
          return change();
        } finally {
          this.unlock(path, owner);
        }
      }
      await setTimeout(5);
    }
    throw new StoreLockError(path);
  }
  inboxPath(id) {
    return this.path("inbox", `${hash(id)}.json`);
  }
  claimPath(id) {
    return this.path("delivered", hash(id));
  }
  entryAt(path) {
    const stored = this.read(path, parseStored);
    if (!stored)
      return;
    const id = stored.item.id;
    if (path !== this.inboxPath(id))
      throw new StoreFormatError(path);
    const delivered = this.read(this.claimPath(id), parseClaim);
    return delivered ? { ...stored, delivered } : stored;
  }
  inbox = {
    put: async (item) => {
      const valid = parseItem(item);
      if (!valid)
        throw new Error("Inbox item is not a valid protocol item");
      const path = this.inboxPath(valid.id);
      const receivedAtMs = this.read(path, parseStored)?.receivedAtMs ?? this.clock.now();
      this.write(path, { item: valid, receivedAtMs });
    },
    get: async (id) => this.entryAt(this.inboxPath(id)),
    list: async () => this.names(this.path("inbox"), HASHED_JSON).flatMap((name) => this.entryAt(this.path("inbox", name)) ?? []).sort((a, b) => a.receivedAtMs - b.receivedAtMs || (a.item.id < b.item.id ? -1 : a.item.id > b.item.id ? 1 : 0))
  };
  delivered = {
    claim: async (id, sessionId) => {
      if (!sessionId)
        throw new Error("Session id must not be empty");
      const path = this.claimPath(id);
      this.publish(path, { sessionId, atMs: this.clock.now() }, randomUUID());
      return this.read(path, parseClaim)?.sessionId === sessionId;
    },
    get: async (id) => this.read(this.claimPath(id), parseClaim)
  };
  readOutbox() {
    const path = this.path("outbox.json");
    const list = this.read(path, (v) => {
      if (!Array.isArray(v))
        return;
      const parsed = v.map(parseRequest);
      return parsed.every((r) => r !== undefined) ? parsed : undefined;
    });
    return new Map((list ?? []).map((r) => [r.id, r]));
  }
  outbox = {
    put: async (request) => {
      const valid = parseRequest(request);
      if (!valid)
        throw new Error("Invalid outbound request");
      await this.locked("outbox", () => {
        const all = this.readOutbox();
        all.set(valid.id, valid);
        this.write(this.path("outbox.json"), [...all.values()]);
      });
    },
    list: async () => [
      ...this.readOutbox().values()
    ],
    remove: async (id) => this.locked("outbox", () => {
      const all = this.readOutbox();
      if (!all.delete(id))
        return;
      this.write(this.path("outbox.json"), [...all.values()]);
    })
  };
  sessionPath(id) {
    return this.path("sessions", `${hash(id)}.json`);
  }
  allSessions() {
    return this.names(this.path("sessions"), HASHED_JSON).flatMap((name) => {
      const path = this.path("sessions", name);
      const record = this.read(path, parseSession);
      if (!record)
        return [];
      if (path !== this.sessionPath(record.sessionId))
        throw new StoreFormatError(path);
      return [{ path, record }];
    });
  }
  sessions = {
    beat: async (session) => {
      const record = parseSession({ ...session, seenAtMs: this.clock.now() });
      if (!record)
        throw new Error("Invalid session heartbeat");
      this.write(this.sessionPath(record.sessionId), record);
    },
    live: async () => {
      const now = this.clock.now();
      return this.allSessions().map((s) => s.record).filter((s) => now - s.seenAtMs < SESSION_LIVE_MS).sort((a, b) => a.sessionId < b.sessionId ? -1 : 1);
    },
    remove: async (sessionId) => {
      this.remove(this.sessionPath(sessionId));
    }
  };
  repoDir(repo) {
    const parts = [repo.host, repo.owner, repo.name];
    if (!parts.every((p) => SEGMENT2.test(p) && p !== "." && p !== ".."))
      throw new Error("Repository host, owner and name must be plain names");
    return this.path("repos", ...parts);
  }
  repos = {
    read: async (repo, file) => this.read(join4(this.repoDir(repo), `${file}.json`), (v) => v),
    write: async (repo, file, value) => {
      const dir = this.repoDir(repo);
      const host = this.path("repos", repo.host);
      for (const d of [host, join4(host, repo.owner), dir])
        this.ensureDir(d);
      this.write(join4(dir, `${file}.json`), value);
    }
  };
  readCursors() {
    const path = this.path("cursors.json");
    const cursors = this.read(path, parseCursors);
    return cursors ?? { cursors: new Map, lastRun: new Map };
  }
  changeCursors(change) {
    return this.locked("cursors", () => {
      const c = this.readCursors();
      change(c);
      this.write(this.path("cursors.json"), {
        cursors: Object.fromEntries(c.cursors),
        lastRun: Object.fromEntries(c.lastRun)
      });
    });
  }
  cursors = {
    get: async (name) => this.readCursors().cursors.get(name),
    set: async (name, value) => this.changeCursors((c) => {
      c.cursors.set(name, value);
    })
  };
  jobs = {
    run: async (name, intervalMs, fn) => {
      const path = this.lockPath(`job:${name}`);
      const owner = this.tryLock(path, JOB_LOCK_TTL_MS);
      if (!owner)
        return "busy";
      try {
        const startedAt = this.clock.now();
        const last = this.readCursors().lastRun.get(name);
        if (last !== undefined && startedAt - last < intervalMs)
          return "fresh";
        const record = () => this.changeCursors((c) => {
          c.lastRun.set(name, startedAt);
        });
        try {
          await fn();
        } catch (error) {
          await record().catch(() => {});
          throw error;
        }
        await record();
        return "ran";
      } finally {
        this.unlock(path, owner);
      }
    },
    lastRun: async (name) => this.readCursors().lastRun.get(name)
  };
  kvPath(key) {
    return this.path("kv", `${hash(key)}.json`);
  }
  readKv(key) {
    const path = this.kvPath(key);
    return this.read(path, (v) => {
      const raw = fields(v);
      return raw && raw.key === key && Object.hasOwn(raw, "value") ? { value: raw.value } : undefined;
    })?.value;
  }
  kv = {
    get: async (key) => this.readKv(key),
    set: async (key, value) => {
      this.write(this.kvPath(key), { key, value });
    },
    update: async (key, fn) => this.locked(`kv:${key}`, () => {
      const value = fn(this.readKv(key));
      this.write(this.kvPath(key), { key, value });
      return value;
    })
  };
  events = {
    append: async (event) => {
      const path = this.path("events.ndjson");
      const size = () => {
        try {
          return statSync(path).size;
        } catch (error) {
          if (isCode(error, "ENOENT"))
            return 0;
          throw error;
        }
      };
      if (size() >= EVENTS_ROTATE_BYTES)
        await this.locked("events", () => {
          if (size() >= EVENTS_ROTATE_BYTES)
            renameSync(path, `${path}.1`);
        });
      appendFileSync(path, `${JSON.stringify(event)}
`, { mode: 384 });
    },
    read: async () => {
      const path = this.path("events.ndjson");
      const events = [];
      for (const file of [`${path}.1`, path]) {
        let text;
        try {
          text = readFileSync2(file, "utf8");
        } catch (error) {
          if (isCode(error, "ENOENT"))
            continue;
          throw error;
        }
        for (const line of text.split(`
`)) {
          if (!line)
            continue;
          try {
            const value = JSON.parse(line);
            if (typeof value === "object" && value !== null && !Array.isArray(value))
              events.push(value);
          } catch {}
        }
      }
      return events;
    }
  };
  pruneTemps(dir) {
    for (const entry of readdirSync2(dir, { withFileTypes: true })) {
      const path = join4(dir, entry.name);
      if (entry.isDirectory())
        this.pruneTemps(path);
      const pid = Number(TEMP.exec(entry.name)?.[1]);
      if (entry.isFile() && isPid(pid) && !this.alive(pid))
        this.remove(path);
    }
  }
  prune = async () => {
    const now = this.clock.now();
    for (const name of this.names(this.path("delivered"), HASHED)) {
      const claim = this.read(this.path("delivered", name), parseClaim);
      if (!claim || now - claim.atMs < RETENTION_MS)
        continue;
      this.remove(this.path("inbox", `${name}.json`));
      this.remove(this.path("delivered", name));
    }
    for (const { path, record } of this.allSessions())
      if (now - record.seenAtMs >= RETENTION_MS)
        this.remove(path);
    const held = new Set(this.names(this.path("locks"), LOCK).map((name) => this.readOwner(this.path("locks", name))?.token));
    for (const name of this.names(this.path("locks"), MARKER2)) {
      const path = this.path("locks", name);
      const reaper = this.readOwner(path);
      if (reaper && this.stale(reaper) && !held.has(MARKER2.exec(name)?.[1]))
        this.remove(path);
    }
    this.pruneTemps(this.root);
  };
}

// src/app/settings.ts
var DEFAULT_SETTINGS = {
  autoWake: "reply",
  agentsMerge: undefined,
  idleMinutes: 10,
  watch: [],
  mute: []
};
var slugs = (value, name, problems) => {
  if (value === undefined)
    return [];
  if (!Array.isArray(value) || !value.every((v) => typeof v === "string" && /^[^/\s]+\/[^/\s]+$/.test(v))) {
    problems.push(`${name}: expected a list of owner/repo`);
    return [];
  }
  return value.map((v) => v.toLowerCase());
};
function parseSettings(text) {
  const problems = [];
  if (text === undefined)
    return { settings: DEFAULT_SETTINGS, problems };
  let raw;
  try {
    raw = JSON.parse(text);
  } catch {
    return {
      settings: DEFAULT_SETTINGS,
      problems: ["config.json is not valid JSON"]
    };
  }
  if (!isRecord(raw)) {
    return {
      settings: DEFAULT_SETTINGS,
      problems: ["config.json must hold an object"]
    };
  }
  let autoWake = DEFAULT_SETTINGS.autoWake;
  if (raw.autoWake === "reply" || raw.autoWake === "off") {
    autoWake = raw.autoWake;
  } else if (raw.autoWake !== undefined) {
    problems.push('autoWake: expected "reply" or "off"');
  }
  let agentsMerge = DEFAULT_SETTINGS.agentsMerge;
  if (typeof raw.agentsMerge === "boolean") {
    agentsMerge = raw.agentsMerge;
  } else if (raw.agentsMerge !== undefined) {
    problems.push("agentsMerge: expected true or false");
  }
  let idleMinutes = DEFAULT_SETTINGS.idleMinutes;
  if (typeof raw.idleMinutes === "number" && Number.isFinite(raw.idleMinutes) && raw.idleMinutes > 0) {
    idleMinutes = raw.idleMinutes;
  } else if (raw.idleMinutes !== undefined) {
    problems.push("idleMinutes: expected a positive number");
  }
  return {
    settings: {
      autoWake,
      agentsMerge,
      idleMinutes,
      watch: slugs(raw.watch, "watch", problems),
      mute: slugs(raw.mute, "mute", problems)
    },
    problems
  };
}

// src/cli/runtime.ts
function readConfigFile(dir) {
  try {
    return readFileSync3(join5(dir, "config.json"), "utf8");
  } catch (error) {
    if (error.code === "ENOENT")
      return;
    throw error;
  }
}
function createRuntime(cwd, env = process.env) {
  let built;
  return {
    cwd,
    now: () => Date.now(),
    detach(args) {
      const script = process.argv[1];
      if (!script)
        return;
      spawn(process.execPath, [script, ...args], {
        cwd,
        detached: true,
        stdio: "ignore"
      }).unref();
    },
    ports() {
      if (built)
        return built;
      const clock = { now: () => Date.now() };
      const envPort = new EnvAdapter({ repoDir: cwd, env, home: homedir3() });
      const store = new FileStoreAdapter(defaultStateDir(env, homedir3()), clock);
      const gitByDir = new Map;
      const githubByHost = new Map;
      const { settings, problems } = parseSettings(readConfigFile(envPort.configDir()));
      built = {
        store,
        clock,
        env: envPort,
        settings,
        settingsProblems: problems,
        git(dir) {
          let git = gitByDir.get(dir);
          if (!git) {
            git = new GitAdapter(dir);
            gitByDir.set(dir, git);
          }
          return git;
        },
        github(host) {
          let github = githubByHost.get(host);
          if (!github) {
            github = new GitHubAdapter({
              host,
              tokenProvider: () => envPort.githubToken(host),
              kv: store.kv,
              now: clock.now
            });
            githubByHost.set(host, github);
          }
          return github;
        }
      };
      return built;
    }
  };
}

// src/cli/index.ts
var code = await main(process.argv.slice(2), createRuntime(process.cwd()), {
  out: (text) => process.stdout.write(text),
  err: (text) => process.stderr.write(text)
});
process.exitCode = code;
