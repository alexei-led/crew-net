// src/cli/commands/sync.ts
var sync = {
  name: "sync",
  summary: "One sync pass: every due job (notifications, PRs, fetch, radar, deps)",
  usage: `Usage: crew-net sync [--once] [--detach] [--json] [--repo owner/repo]
  Runs one pass and exits; jobs that ran recently on this laptop are skipped.
  --detach starts the pass in the background and returns at once (for hooks).
  --once is accepted for clarity; a pass is always one pass.`,
  spec: { values: [], switches: ["--once", "--detach"] },
  async run(ctx) {
    if (ctx.args.positional.length > 0)
      throw new UsageError(`unexpected argument ${ctx.args.positional[0]}`);
    if (ctx.args.switches.has("--detach")) {
      ctx.runtime.detach([
        "sync",
        "--once",
        ...ctx.repo ? ["--repo", ctx.repo] : []
      ]);
      print(ctx, { detached: true }, "");
      return 0;
    }
    const ports = ctx.runtime.ports();
    const { here } = await locate3(ctx, ports);
    const report = await runSync(ports, here);
    const failed = report.jobs.filter((j) => j.outcome === "failed");
    const text = [
      ...failed.map((j) => `crew-net sync: ${j.job} failed: ${j.error}`),
      ...report.notice ? [report.notice] : []
    ];
    print(ctx, report, text.length ? `${text.join(`
`)}
` : "");
    return failed.length > 0 ? 1 : 0;
  }
};

// src/cli/commands/watch.ts
import { createInterface } from "node:readline";

// src/watch/index.ts
var TICK_MS = 30000;
async function runWatch(ports, sessionId, io, tickMs = TICK_MS) {
  const emit = (event) => io.write(`${encodeEvent(event)}
`);
  const watcher = new Watcher(ports, sessionId, emit);
  let queue = Promise.resolve();
  const serial = (fn) => {
    queue = queue.then(fn).catch((error) => emit({
      type: "error",
      message: error instanceof Error ? error.message : String(error)
    }));
    return queue;
  };
  let stop = () => {};
  const done = new Promise((resolve) => {
    stop = resolve;
  });
  io.stopped.then(() => stop(0));
  let ticking = false;
  const timer = setInterval(() => {
    if (!io.parentAlive()) {
      stop(0);
      return;
    }
    if (!watcher.started || ticking)
      return;
    ticking = true;
    serial(() => watcher.tick()).finally(() => {
      ticking = false;
    });
  }, tickMs);
  emit({ type: "ready" });
  (async () => {
    let helloSeen = false;
    for await (const line of io.lines) {
      if (!line.trim())
        continue;
      const decoded = decodeEvent(line);
      if (!decoded.ok) {
        emit({ type: "error", message: `bad event: ${decoded.detail}` });
        continue;
      }
      const event = decoded.event;
      if (event.type === "hello") {
        helloSeen = true;
        serial(() => watcher.start(event));
      } else if (event.type === "ack") {
        serial(() => watcher.ack(event));
      } else if (event.type === "bye") {
        await serial(() => watcher.bye());
        stop(0);
        return;
      } else {
        emit({ type: "error", message: `unexpected event ${event.type}` });
      }
    }
    if (!helloSeen) {
      emit({ type: "error", message: "stdin closed before hello" });
      stop(1);
    }
  })();
  const code = await done;
  clearInterval(timer);
  watcher.stop();
  await queue;
  return code;
}
async function sendToWatch(ports, sessionId, lines, report) {
  const watcher = new Watcher(ports, sessionId, () => {});
  let bad = 0;
  for await (const line of lines) {
    if (!line.trim())
      continue;
    const decoded = decodeEvent(line);
    if (!decoded.ok) {
      bad++;
      report(`bad event: ${decoded.detail}`);
      continue;
    }
    const event = decoded.event;
    if (event.type === "ack")
      await watcher.ack(event);
    else if (event.type === "bye")
      await watcher.bye();
    else {
      bad++;
      report(`unexpected event ${event.type}`);
    }
  }
  return bad;
}

// src/cli/commands/watch.ts
function alive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return error.code === "EPERM";
  }
}
var watch = {
  name: "watch",
  summary: "Watcher child of the Claude Code mod (NDJSON on stdin/stdout)",
  usage: `Usage: crew-net watch --session <id>
       crew-net watch send --session <id>
  watch: write ready, read hello on stdin (EOF after it is normal), then
  emit item/status/error events until bye, SIGTERM or the parent's death.
  send: read ack and bye lines on stdin, apply them, exit.`,
  spec: { values: ["--session"], switches: [] },
  async run(ctx) {
    const sessionId = single(ctx.args, "--session");
    if (!sessionId)
      throw new UsageError("--session is required");
    const [action, ...extra] = ctx.args.positional;
    if (extra.length > 0 || action !== undefined && action !== "send")
      throw new UsageError(`unexpected argument ${extra[0] ?? action}`);
    const lines = createInterface({
      input: process.stdin,
      crlfDelay: Infinity
    });
    try {
      if (action === "send") {
        const bad = await sendToWatch(ctx.runtime.ports(), sessionId, lines, (message) => ctx.io.err(`crew-net watch send: ${message}
`));
        return bad > 0 ? 1 : 0;
      }
      const parent = process.ppid;
      const stopped = new Promise((resolve) => {
        process.once("SIGTERM", () => resolve());
        process.once("SIGINT", () => resolve());
      });
      return await runWatch(ctx.runtime.ports(), sessionId, {
        lines,
        write: (line) => ctx.io.out(line),
        parentAlive: () => process.ppid === parent && parent !== 1 && alive(parent),
        stopped
      });
    } finally {
      lines.close();
    }
  }
};

// src/cli/commands/who.ts
import { isAbsolute as isAbsolute3, relative as relative2, resolve as resolve3 } from "node:path";
var who2 = {
  name: "who",
  summary: "Open work in watched repos that touches these paths",
  usage: `Usage: crew-net who [paths...] [--json] [--repo owner/repo]
  Paths are relative to the current directory. Without paths, lists all
  open work by others. Run it before starting work.`,
  spec: { values: [], switches: [] },
  async run(ctx) {
    const ports = ctx.runtime.ports();
    const { here, root } = await locate3(ctx, ports);
    const repos = new Map;
    if (here)
      repos.set(repoKey(here.ref), here.ref);
    if (!ctx.repo) {
      for (const key of Object.keys(await readWatched(ports.store))) {
        const ref = refFromKey(key);
        if (ref)
          repos.set(key, ref);
      }
    }
    const paths = ctx.args.positional.map((p) => {
      if (!root)
        return p;
      const rel = relative2(root, resolve3(ctx.runtime.cwd, p));
      return rel.startsWith("..") || isAbsolute3(rel) ? p : rel || ".";
    });
    const entries = await who(ports.store, [...repos.values()], paths.map((p) => p === "." ? "" : p));
    print(ctx, entries, renderWho(entries));
    return 0;
  }
};

